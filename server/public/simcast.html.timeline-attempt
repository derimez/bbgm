			// on court so the shooter is always a real, correct-team player.
			function ensurePlayer(pid, t) {
				if (players[pid]) return players[pid];
				if (typeof pid !== "number" || (t !== 0 && t !== 1)) return null;
				let info = teams[t]?.players?.find((p) => p.pid === pid);
				if (!info) {
