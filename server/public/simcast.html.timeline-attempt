				}
			}

			// Compute a shot's (x,y) ONCE and cache it on the event object. The planner's
			// pre-staging target and the handler's ball-launch point must agree — without
			// this the planner sends the shooter to spot A while the handler fires the
			// ball from a fresh random spot B, so the ball appears to teleport.
			function shotSpotFor(ev) {
				if (!ev.__spot)
					ev.__spot = shotSpot(ev.type, ev.t, roleOf(ev.pid, ev.t));
				return ev.__spot;
			}

			// ── DOM refs ──────────────────────────────────────────────────────────────
			const stageEl = document.getElementById("stage");
			const idleEl = document.getElementById("idle-overlay");
			const subline = document.getElementById("subline");
			const connEl = document.getElementById("connstatus");
			const clockEl = document.getElementById("clock");
			const quarterEl = document.getElementById("quarter");
			const playEl = document.getElementById("play");
			const scoreH = document.getElementById("score-home");
			const scoreA = document.getElementById("score-away");
			const abbrevH = document.getElementById("abbrev-home");
			const abbrevA = document.getElementById("abbrev-away");
			const teamStatsEl = document.getElementById("teamstats");
			const speedEl = document.getElementById("speed");
			const speedVal = document.getElementById("speed-val");

			// Manual multiplier ON TOP of the BBGM-slaved gameRate. 1× = exactly BBGM's
			// pace; default 0.5× so the on-court motion is slow enough to actually study
			// (BBGM's own slider only paces the play-by-play, not this animation). Drag it
			// up toward 1× to track BBGM in real time. Below ~0.9× the blur-catch-up is
			// disabled (see scheduleDrain) so slow really stays slow.
			let speed = 0.5;
			speedEl.value = "0.5";
			speedVal.textContent = "0.5×";
