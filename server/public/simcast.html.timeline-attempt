			function layoutWorld() {
				const fullW = COURT.length + APRON_FT * 2;
				const fullH = COURT.width + APRON_FT * 2;
				const sx = app.renderer.width / fullW;
				const sy = app.renderer.height / fullH;
				const s = Math.min(sx, sy);
				world.scale.set(s, s);
				world.x = (app.renderer.width - fullW * s) / 2 + APRON_FT * s;
