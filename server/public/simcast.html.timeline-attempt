			const COURT_LINE = 0xfaf2dd; // ivory court lines
			const COURT_FLOOR = 0xc9a06a; // wood floor
			const COURT_APRON = 0x6b4a2a; // darker apron
			const COURT_BACKBOARD = 0x222222;
			const COURT_RIM = 0xe65b1c;

			let courtGfx = null;
			let courtSprite = null; // textured court sprite (when manifest hits)
			function drawCourt(homePaintColor, awayPaintColor) {
				if (courtGfx) world.removeChild(courtGfx);
				// If we previously had a textured sprite, drop it — a procedural-only
				// redraw means we don't want the old sprite still on top of the apron.
				if (courtSprite) {
					world.removeChild(courtSprite);
					courtSprite = null;
