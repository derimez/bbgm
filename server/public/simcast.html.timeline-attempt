<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, viewport-fit=cover"
		/>
		<title>BBGM Simcast — Live</title>
		<style>
			:root {
				color-scheme: dark;
			}
			html,
			body {
				margin: 0;
				padding: 0;
				background: #0c0e12;
				color: #d8dde7;
				font-family:
					-apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
			}
			body {
				display: flex;
				flex-direction: column;
				align-items: center;
				padding: 12px 12px 24px;
				gap: 10px;
				min-height: 100vh;
			}
			/* Embedded mode: stripped chrome so it fits inside BBGM's LiveGame view. */
			body.embedded {
				padding: 0;
				min-height: auto;
				gap: 6px;
				background: transparent;
			}
			body.embedded h1,
			body.embedded > p.sub {
				display: none;
			}
			body.embedded #stage {
				border-radius: 0;
				/* Drop the 940px cap so the court fills the entire iframe width. */
				max-width: 100%;
			}
			/* BBGM's LiveGame view already shows score, clock, last-play and playback
     controls above the iframe — hide the redundant overlay cards inside. */
			body.embedded .overlay {
				display: none;
			}
			/* ...but KEEP a slim speed control inside the embed. BBGM's own speed slider
     only paces the play-by-play; this one paces the simcast animation, and it's
     the only way to slow the on-court motion enough to study it. */
			.speedbar {
				display: flex;
				justify-content: center;
				margin-top: 6px;
			}
			.speedbar .card {
				display: flex;
				align-items: center;
				gap: 10px;
				padding: 6px 12px;
			}
			.speedbar h2 {
				margin: 0;
			}
			body.embedded .speedbar .card {
				background: rgba(0, 0, 0, 0.25);
				padding: 4px 10px;
			}
			h1 {
				margin: 4px 0 0;
				font-size: 18px;
				font-weight: 600;
				letter-spacing: 0.02em;
			}
			.sub {
				margin: 0;
				font-size: 11px;
				color: #7c8597;
			}
			#connstatus {
				display: inline-block;
				padding: 2px 8px;
				border-radius: 4px;
				font-size: 10px;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				margin-left: 8px;
				vertical-align: middle;
			}
			#connstatus.live {
				background: #1a4d2e;
				color: #6ee7a0;
			}
			#connstatus.idle {
				background: #3a2a1a;
				color: #f0b070;
			}
			#connstatus.dead {
				background: #4a1a1a;
				color: #ff8080;
			}
			#stage {
				width: 100%;
				position: relative;
				max-width: min(940px, calc((100svh - 110px) * 94 / 50));
				aspect-ratio: 94 / 50;
				margin: 0 auto;
				background: #0c0e12;
				border-radius: 8px;
				overflow: hidden;
				box-shadow:
					0 1px 0 #1d2230 inset,
					0 8px 24px rgba(0, 0, 0, 0.4);
			}
			#stage canvas {
				display: block;
				width: 100% !important;
				height: 100% !important;
				touch-action: pan-y;
			}
			#idle-overlay {
				position: absolute;
				inset: 0;
				display: grid;
				place-items: center;
				background: rgba(12, 14, 18, 0.85);
				z-index: 5;
				pointer-events: none;
				color: #b9c0cf;
				font-size: 14px;
				text-align: center;
				padding: 24px;
				transition: opacity 0.3s ease;
			}
			#idle-overlay.hidden {
				opacity: 0;
			}
			.overlay {
				width: 100%;
				max-width: 940px;
				display: flex;
				gap: 10px;
				justify-content: space-between;
				align-items: stretch;
				flex-wrap: wrap;
			}
			.card {
				background: #141823;
				border: 1px solid #1d2230;
				border-radius: 8px;
				padding: 10px 12px;
				flex: 1 1 200px;
			}
			.card h2 {
				font-size: 10px;
				margin: 0 0 4px;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: #7c8597;
				font-weight: 600;
			}
			.clock {
				font-variant-numeric: tabular-nums;
				font-size: 22px;
				font-weight: 700;
			}
			.play {
				font-size: 13px;
				color: #b9c0cf;
				min-height: 1.2em;
			}
			.score {
				display: flex;
				gap: 14px;
				align-items: baseline;
			}
			.score .team {
				font-size: 11px;
				color: #7c8597;
			}
			.score .pts {
				font-size: 22px;
				font-weight: 700;
				font-variant-numeric: tabular-nums;
			}
			.speed {
				display: flex;
				align-items: center;
				gap: 10px;
			}
			.speed input[type="range"] {
				flex: 1;
			}
			.speed .val {
				width: 42px;
				text-align: right;
				font-variant-numeric: tabular-nums;
			}
			.statline {
				font-size: 11px;
				color: #7c8597;
				margin-top: 6px;
				line-height: 1.5;
			}
			.statline b {
				color: #b9c0cf;
				font-weight: 600;
			}
		</style>
	</head>
	<body>
		<h1>BBGM Simcast — Live <span id="connstatus" class="idle">idle</span></h1>
		<p class="sub" id="subline">Waiting for a live game…</p>

		<div id="stage">
			<div id="idle-overlay">
				Connect to BBGM and start a live game (Tools → "Watch Live") to begin
				streaming.
			</div>
		</div>

		<div class="overlay">
			<div class="card">
				<h2>Clock</h2>
				<div class="clock" id="clock">--:--</div>
				<div class="sub" id="quarter">—</div>
			</div>
			<div class="card">
				<h2>Last Play</h2>
				<div class="play" id="play">—</div>
				<div class="statline" id="teamstats">—</div>
			</div>
			<div class="card">
				<h2>Score</h2>
				<div class="score">
					<div>
						<div class="team" id="abbrev-home">HOME</div>
						<div class="pts" id="score-home">0</div>
					</div>
					<div>
						<div class="team" id="abbrev-away">AWAY</div>
						<div class="pts" id="score-away">0</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Speed control lives OUTSIDE .overlay so it stays visible in the embedded
		     LiveGame view (where the rest of the overlay is hidden). -->
		<div class="speedbar">
			<div class="card">
				<h2>Speed</h2>
				<div class="speed">
					<input
						type="range"
						id="speed"
						min="0.15"
						max="6"
						step="0.05"
						value="0.5"
					/>
					<span class="val" id="speed-val">0.5×</span>
				</div>
			</div>
		</div>

		<script type="module">
			import * as PIXI from "https://cdn.jsdelivr.net/npm/pixi.js@8.5.2/dist/pixi.min.mjs";

			// Strip page chrome when iframed from BBGM's LiveGame view.
			if (new URLSearchParams(location.search).get("embedded") === "1") {
				document.body.classList.add("embedded");
			}

			// ── Court (feet) ───────────────────────────────────────────────────────────
			const COURT = { length: 94, width: 50, basketFromBaseline: 5.25 };
			const RIM_X = { 0: 5.25, 1: 88.75 }; // BASE ends: t=0 left, t=1 right (H1)
			const RIM_Y = 25;
			const APRON_FT = 6; // visible apron extending past playing surface

			// ── Attacking direction (which hoop) ───────────────────────────────────────
			// At the opening tip, team 0 attacks the left rim and team 1 the right (the
			// RIM_X base). Real teams SWAP baskets at halftime and keep the swapped ends
			// for the rest of the game, overtime included — so periods 1-2 use the base
			// ends and periods 3+ mirror them. Every "which rim / which baseline" decision
			// in the engine must go through these helpers, never RIM_X[t] directly, or the
			// second half will shoot on the wrong hoop.
			function sidesSwapped() {
				return currentPeriod >= 3;
			}
			// The physical rim team t attacks RIGHT NOW.
			function attackRimX(t) {
				return sidesSwapped() ? RIM_X[1 - t] : RIM_X[t];
			}
			// The rim team t defends (opponent's attack rim).
			function defendRimX(t) {
				return attackRimX(1 - t);
			}
			// Sign pointing from the attack rim back into the court (−1 if rim on the
			// right, +1 if on the left) — used to place shots/FTs out from the rim.
			function attackDir(t) {
				return attackRimX(t) > 47 ? -1 : 1;
			}
			// The baseline (x=0 or x=94) behind the rim team t attacks.
			function attackBaselineX(t) {
				return attackRimX(t) > 47 ? 94 : 0;
			}

			// ── Motion physics ─────────────────────────────────────────────────────────
			// NBA reference: top sprint ≈ 17 mph ≈ 25 ft/s; jog ≈ 10 mph ≈ 14 ft/s;
			// dead-ball walk ≈ 5 mph ≈ 7 ft/s. Every moveTo clamps its target to what's
			// reachable in the available time so no one teleports.
			// Velocity caps scaled ~25% below true NBA speeds because at our zoomed-out
			// top-down view, real-world top speeds read as teleporting. 19 ft/s feels
			// like a sprint to the eye; 11 ft/s reads as a jog; 5.5 ft/s as a walk.
			const MAX_FPS_BY_URGENCY = { sprint: 19, jog: 11, walk: 5.5 };
			// Multiplier on the urgency caps only. Keep at 1.0: the overall slowdown comes
			// from PACING (the speed multiplier stretches every gap) + paceScale() below.
			const MOTION_SCALE = 1.0;
			// ── Pace-linked motion speed ───────────────────────────────────────────────
			// On-screen locomotion tracks BBGM's LIVE pace so a slowly-simmed game is
			// genuinely easy to follow. effRate = gameRate*speed (game-seconds shown per
			// real second); we scale every urgency cap by effRate/PACE_REF (clamped). The
			// crucial property: each event gap also stretches as 1/effRate, so distance
			// covered per gap = cap*gap = (capBase·effRate/REF)·(Δ/effRate) = capBase·Δ/REF
			// is INDEPENDENT of pace — players still traverse the floor within a possession
			// (no center-bunching), only the on-screen SPEED changes. At BBGM's slowest this
			// crawls (easy to track); at its fastest it's a brisk but never-teleporting clip.
			// effRate at which motion runs ~full speed. Tuned so BBGM's SLOWEST sim speed
			// (settled effRate ~2) crawls at ~3 ft/s (very trackable), a mid speed (~5) is a
			// slow ~6.5 ft/s jog, and the fastest (~25) is a brisk (never-teleporting) ~18.
			// Verified no center-bunching at mid speed (spread 60 ft, min 26). Raise to slow
			// motion further, lower to speed it up.
			let PACE_REF = 13.0; // effRate (game-sec/real-sec) at which motion runs ~full
			function paceScale() {
				const eff = gameRate * speed;
				return clamp(eff / PACE_REF, 0.12, 0.95);
			}
			window.__setPaceRef = (v) => {
				PACE_REF = v;
			};
			const MIN_DUR = 0.25; // floor on any move duration
			// Continuous steering model (replaces stop-at-every-target tweens): each player
			// carries a velocity and steers toward a target with smooth acceleration and an
			// arrival slowdown, so re-targeting mid-move flows instead of snapping to a stop.
			const STEER_K = 5.5; // velocity smoothing rate (higher = snappier, lower = floatier)
			const ARRIVE_RADIUS = 5.0; // ft: start easing to a stop within this of the target
			const MIN_MOVE_SPEED = 1.2; // ft/s floor so even short moves keep gliding
			const PASS_LEAD_SEC = 0.5; // ball detaches from assister this long before make
			const ASSIST_PASS_DIST_MIN = 15; // assister parks this far from shooter
			const ASSIST_PASS_DIST_MAX = 22;

			// Fallback palettes when a team's gameStart packet has no colors[] array
			// (e.g. an exhibition game without per-team color overrides).
			const DEFAULT_COLORS = {
				home: 0x006bb6,
				homeRing: 0xf58426, // Knicks blue + orange
				away: 0xfdb927,
				awayRing: 0x552583, // Lakers gold + purple
				ball: 0xe25822,
				bg: 0x0c0e12,
			};

			// Per-team resolved palette (primary + secondary) — populated from gameStart
			// packet. Indexed by team slot (0 = home, 1 = away).
			const teamColors = [
				{ primary: DEFAULT_COLORS.home, secondary: DEFAULT_COLORS.homeRing },
				{ primary: DEFAULT_COLORS.away, secondary: DEFAULT_COLORS.awayRing },
			];

			// Convert "#rrggbb" to 0xrrggbb; passthrough numbers; null/undefined → null
			function parseColor(c) {
				if (typeof c === "number") return c;
				if (typeof c !== "string") return null;
				const m = c.replace("#", "");
				if (!/^[0-9a-fA-F]{6}$/.test(m)) return null;
				return parseInt(m, 16);
			}

			// Approx height by position (drives dot radius — gameStart packet doesn't yet
			// carry real hgt; this is the position fallback).
			const POS_HGT = { PG: 74, SG: 78, SF: 80, PF: 82, C: 84, G: 76, F: 81 };
			const dotRadius = (h) => 1.05 + (h - 72) * 0.06;

			// Per-play role spots. Each possession picks a play type, which defines where
			// every role lines up at shot time. Inspired by NBA actions:
			//   set     — standard 4-out 1-in spacing
			//   pnr     — high pick-and-roll, C at the screen, PF in the dunker spot
			//   motion  — flatter, more even spacing with bigs higher up
			//   post    — feed C in the low post, perimeter players spaced for the kick
			//   iso     — clear-out one wing, others on the opposite side
			// All coords are offensive-halfcourt (dx = distance from attacking baseline).
			// Many spots per role — each play picks ONE per role randomly. Spots cover the
			// full halfcourt (corners, wings, slots, elbows, blocks, dunker spot, high post),
			// so the same 5-on-5 floor doesn't repeat possession to possession.
			// Coords are offensive-halfcourt (dx = distance from attacking baseline).
			const PLAY_PLAYBOOK = {
				set: {
					// 4-out 1-in spacing with handler variety.
					PG: [
						[33, 25],
						[30, 14],
						[30, 36],
						[36, 22],
					],
					SG: [
						[20, 6],
						[22, 12],
						[16, 16],
						[27, 10],
					],
					SF: [
						[20, 44],
						[22, 38],
						[16, 34],
						[27, 40],
					],
					PF: [
						[8, 18],
						[14, 18],
						[18, 22],
						[12, 14],
						[22, 19],
					],
					C: [
						[5, 28],
						[8, 32],
						[6, 22],
						[10, 30],
					],
				},
				pnr: {
					// High screen-and-roll on the strong side. C up top, PF in dunker.
					PG: [
						[28, 22],
						[28, 28],
						[32, 18],
					],
					SG: [
						[18, 6],
						[22, 10],
					], // weak corner / wing
					SF: [
						[18, 44],
						[22, 40],
					], // strong corner / wing
					PF: [
						[12, 30],
						[8, 22],
					], // dunker / weakside block
					C: [
						[26, 25],
						[24, 28],
						[28, 22],
					], // ball screen at the top
				},
				motion: {
					// Flatter, with bigs floating to the elbow / mid-range — pick-and-pop look.
					PG: [
						[35, 22],
						[30, 28],
						[32, 14],
					],
					SG: [
						[24, 10],
						[22, 14],
						[16, 22],
					],
					SF: [
						[24, 40],
						[22, 36],
						[16, 28],
					],
					PF: [
						[19, 18],
						[21, 22],
						[18, 32],
					], // mid-range
					C: [
						[19, 30],
						[22, 25],
						[12, 18],
					],
				},
				post: {
					// Feed the C in the low post; perimeter spread for the kick.
					PG: [
						[34, 25],
						[30, 18],
					],
					SG: [
						[22, 6],
						[25, 12],
					], // weak corner / wing
					SF: [
						[22, 44],
						[25, 38],
					], // strong corner / wing
					PF: [
						[18, 33],
						[22, 36],
						[14, 14],
					], // weakside relief
					C: [
						[5, 28],
						[6, 22],
						[7, 30],
					], // low block
				},
				iso: {
					// Clear-out a wing for one isolation attacker; everyone else on the other side.
					PG: [
						[18, 10],
						[22, 14],
						[26, 18],
					], // wing attacker
					SG: [
						[30, 38],
						[34, 32],
					],
					SF: [
						[24, 44],
						[28, 38],
					],
					PF: [
						[22, 36],
						[25, 32],
					],
					C: [
						[10, 40],
						[12, 36],
						[14, 30],
					],
				},
				flare: {
					// Flare screen for a shooter — guards on the same side, big at top.
					PG: [
						[28, 36],
						[32, 30],
					],
					SG: [
						[20, 38],
						[16, 42],
					], // catches the flare
					SF: [
						[20, 10],
						[16, 6],
					], // weak side
					PF: [
						[22, 25],
						[26, 25],
					], // top of arc screener
					C: [
						[10, 22],
						[8, 30],
					], // dunker
				},
				handoff: {
					// Dribble handoff at the elbow — handler and bigman swap roles for a beat.
					PG: [
						[22, 18],
						[22, 32],
					],
					SG: [
						[20, 8],
						[18, 14],
					],
					SF: [
						[20, 42],
						[18, 36],
					],
					PF: [
						[20, 22],
						[24, 25],
					], // hand-off setter at elbow
					C: [
						[10, 25],
						[8, 30],
					],
				},
			};
			// Heavily weighted toward variety — set still common, others fill the deck.
			const PLAY_TYPES = [
				"set",
				"set",
				"pnr",
				"pnr",
				"motion",
				"motion",
				"post",
				"iso",
				"flare",
				"handoff",
			];

			// Free-throw lineup along the lane. dx = distance from the ATTACKING baseline
			// (the rim being shot at); the lane runs y∈[17,33], so its two side lines are
			// y≈17 (bottom) and y≈33 (top). Players stand in the marked lane spaces just
			// outside those lines. NBA rule: defense takes the two spots nearest the rim
			// (first blocks) + a third; offense takes the second blocks; the rest spread on
			// the perimeter as rebound outlets. The shooter (any role) is moved to the FT
			// line (dx≈19) by planMotion, so their role spot here is a harmless placeholder.
			const FT_SPOTS_OFF = {
				C: [11, 16.5], // second block, bottom side
				PF: [11, 33.5], // second block, top side
				PG: [23.5, 25], // top of the key
				SG: [25, 13], // left wing outlet
				SF: [25, 37], // right wing outlet
			};
			const FT_SPOTS_DEF = {
				C: [7.5, 16.5], // first block, bottom (closest to rim)
				PF: [7.5, 33.5], // first block, top (closest to rim)
				SF: [15, 33.5], // third lane space, top
				SG: [22.5, 18], // perimeter box-out / outlet guard
				PG: [22.5, 32], // perimeter box-out / outlet guard
			};
			// Fallback when a player's pos doesn't match (e.g. "F", "G")
			const POS_TO_ROLE = {
				PG: "PG",
				SG: "SG",
				SF: "SF",
				PF: "PF",
				C: "C",
				G: "SG",
				F: "SF",
				GF: "SF",
				FG: "SF",
				FC: "PF",
				CF: "C",
			};

			// A player's natural position rank on the guard→center axis. Real rosters use
			// compound labels (G, GF, F, FG, FC…) that don't map cleanly to one of the five
			// role slots, so we rank every on-court player and hand out the 5 DISTINCT slots
			// (PG,SG,SF,PF,C) by sorted order — otherwise several "GF"/"FC" players collapse
			// onto the same slot and stack on one spot (which wrecked the FT lineup and the
			// half-court spacing). Computed per team at tip and after every substitution.
			const POS_RANK = {
				PG: 0,
				G: 1,
				GG: 1,
				SG: 2,
				SF: 4,
				GF: 3,
				F: 5,
				FG: 4,
				PF: 6,
				FC: 7,
				CF: 8,
				C: 9,
			};
			const ROLE_SLOTS = ["PG", "SG", "SF", "PF", "C"];
			let roleAssign = {}; // pid → one of the 5 distinct role slots
			function assignRolesForTeam(t) {
				const pids = (onCourt[t] ?? []).filter((pid) => players[pid] || teams[t]);
				const ranked = pids
					.map((pid) => {
						const info =
							players[pid]?.info ??
							teams[t]?.players?.find?.((p) => p.pid === pid);
						return { pid, rank: POS_RANK[info?.pos ?? ""] ?? 4 };
					})
					.sort((a, b) => a.rank - b.rank);
				ranked.forEach((r, i) => {
					roleAssign[r.pid] = ROLE_SLOTS[Math.min(i, ROLE_SLOTS.length - 1)];
				});
			}

			// Map team + role to absolute offensive coords for the CURRENT play type.
			// Team 0 attacks the right basket; team 1 attacks the left.
			function offensiveRoleSpot(t, role, variantIdx) {
				const play = PLAY_PLAYBOOK[currentPlay] ?? PLAY_PLAYBOOK.set;
				const spots = play[role] ?? PLAY_PLAYBOOK.set[role] ?? [[16, 25]];
				const [dx, dy] = spots[variantIdx % spots.length];
				// dx is distance from the attacking baseline into the court, so mirror it
				// when that baseline is on the right (x=94).
				return attackBaselineX(t) === 94 ? [94 - dx, dy] : [dx, dy];
			}

			// Free-throw absolute coords. `t` is the offensive team (FT shooter's team).
			function ftRoleSpot(t, role, isOffense) {
				const table = isOffense ? FT_SPOTS_OFF : FT_SPOTS_DEF;
				const [dx, dy] = table[role] ?? table.SF;
				return attackBaselineX(t) === 94 ? [94 - dx, dy] : [dx, dy];
			}

			// The defended rim for team t (the one opponents attack).
			function defendedRimX(t) {
				return defendRimX(t);
			}

			// Resolve a pid's role. Prefer the per-team DISTINCT assignment (so the five
			// on-court players never collide on one slot); fall back to a direct position
			// map for anyone not yet assigned (e.g. a just-subbed player before reassign).
			function roleOf(pid, t) {
				if (roleAssign[pid]) return roleAssign[pid];
				const info = teams[t]?.players?.find?.((p) => p.pid === pid);
				return POS_TO_ROLE[info?.pos ?? ""] ?? "SF";
			}

			// Random point in a region (used to scatter shot locations so the same
			// fgaMidRange doesn't always land on the same spot).
			function rand(lo, hi) {
				return lo + Math.random() * (hi - lo);
			}
			function clamp(v, lo, hi) {
				return v < lo ? lo : v > hi ? hi : v;
			}

			// Given a shot event type and shooting team (and shooter role, optional),
			// pick a plausible (x,y). Role-aware constraints prevent silly placements:
			// a Center taking a 3 stays near the top of the key (no corner 3s), and a
			// Center "mid-range" caps at 12 ft (no 18-ft jumpers off the dribble).
			function shotSpot(type, t, role) {
				const rim = attackRimX(t);
				const dir = attackDir(t); // direction back from rim (period-aware)
				const isBig = role === "C" || role === "PF";
				switch (type) {
					case "fgaAtRim":
						return [rim + dir * rand(0.5, 3.5), rand(20, 30)];
					case "fgaLowPost":
						return [
							rim + dir * rand(4, 9),
							Math.random() < 0.5 ? rand(16, 20) : rand(30, 34),
						];
					case "fgaMidRange": {
						// Centers don't hoist long mid-range — cap at 12 ft for Cs.
						const minD = 10,
							maxD = role === "C" ? 12 : 18;
						return [rim + dir * rand(minD, maxD), rand(7, 43)];
					}
					case "fgaTp":
					case "fgaTpFake": {
						// Bigs taking a 3: limit to top-of-key (y in [15, 35]).
						const yLo = isBig ? 15 : 3;
						const yHi = isBig ? 35 : 47;
						return [rim + dir * rand(22, 27), rand(yLo, yHi)];
					}
					case "fgaTipIn":
						return [rim + dir * rand(0.5, 2.0), rand(22, 28)];
					case "fgaPutBack":
						return [rim + dir * rand(0.5, 4.0), rand(20, 30)];
					case "ft":
						return [rim + dir * 14, 25];
					default:
