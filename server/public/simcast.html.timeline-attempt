			// Resolve a team's manifest key. Prefer the literal abbrev; fall back to
			// region+name lookup (for custom leagues / non-standard abbrevs).
			function resolveManifestKey(team) {
				if (!team) return null;
				if (team.abbrev && courtManifest?.[team.abbrev]) return team.abbrev;
				if (team.region && team.name) {
					const key = `${team.region}/${team.name}`;
					const std = REGION_NAME_TO_ABBREV[key];
					if (std && courtManifest?.[std]) return std;
				}
				return team.abbrev ?? null;
			}

			function pickCourtVariant(abbrev, season) {
				if (!courtManifest || !abbrev) return null;
				const variants = courtManifest[abbrev];
				if (!Array.isArray(variants)) return null;
				let picked = null;
				if (typeof season === "number") {
					for (const v of variants) {
						if (
							v.seasonRange &&
							season >= v.seasonRange[0] &&
							season <= v.seasonRange[1]
						) {
							picked = v;
							break;
						}
					}
				}
				if (!picked) picked = variants.find((v) => !v.seasonRange) ?? null;
				if (!picked) return null;
