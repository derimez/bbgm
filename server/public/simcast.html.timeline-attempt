				const g = new PIXI.Graphics();
				const lw = 0.18; // line width in feet
				// Apron (darker wood) — extends past the playing surface on all sides.
				g.rect(-APRON_FT, -APRON_FT, 94 + APRON_FT * 2, 50 + APRON_FT * 2).fill(
					COURT_APRON,
				);
				// Playing surface (light wood).
				g.rect(0, 0, 94, 50).fill(COURT_FLOOR);

				// Sidelines + baselines.
				g.rect(0, 0, 94, lw).fill(COURT_LINE);
				g.rect(0, 50 - lw, 94, lw).fill(COURT_LINE);
				g.rect(0, 0, lw, 50).fill(COURT_LINE);
				g.rect(94 - lw, 0, lw, 50).fill(COURT_LINE);

				// Half-court line + center circles.
				g.rect(47 - lw / 2, 0, lw, 50).fill(COURT_LINE);
				g.circle(47, 25, 6).stroke({ color: COURT_LINE, width: lw });
				g.circle(47, 25, 2).stroke({ color: COURT_LINE, width: lw });

				// Lane (paint key) — left side, away team color (this is team 1's basket).
				g.rect(0, 17, 19, 16).fill(awayPaintColor);
				g.rect(0, 17, 19, lw).fill(COURT_LINE);
				g.rect(0, 33 - lw, 19, lw).fill(COURT_LINE);
				g.rect(19 - lw, 17, lw, 16).fill(COURT_LINE);
				// FT semicircle (open toward baseline = filled, away from baseline = dashed/open arc).
				g.arc(19, 25, 6, -Math.PI / 2, Math.PI / 2).stroke({
					color: COURT_LINE,
					width: lw,
				});
				// Restricted area (4 ft arc around rim).
				g.arc(5.25, 25, 4, -Math.PI / 2, Math.PI / 2, false).stroke({
					color: COURT_LINE,
					width: lw,
				});

				// Lane (paint key) — right side, home team color (team 0 attacks here).
				g.rect(75, 17, 19, 16).fill(homePaintColor);
				g.rect(75, 17, 19, lw).fill(COURT_LINE);
				g.rect(75, 33 - lw, 19, lw).fill(COURT_LINE);
				g.rect(75, 17, lw, 16).fill(COURT_LINE);
				g.arc(75, 25, 6, Math.PI / 2, (3 * Math.PI) / 2).stroke({
					color: COURT_LINE,
					width: lw,
				});
				g.arc(88.75, 25, 4, Math.PI / 2, (3 * Math.PI) / 2, false).stroke({
					color: COURT_LINE,
					width: lw,
				});

				// 3-pt arc — left side. Rim at (5.25, 25). Arc radius 23.75. Corner-3 lines
				// run from baseline to x = 14, at y = 3 and y = 47. Compute arc-end angles
				// where it meets those lines.
				const arcR = 23.75;
				const cornerY = 3; // distance from sideline
				const cornerX = 14; // distance from baseline where corner straight line ends
				// Left arc: rim center (5.25, 25). Endpoints at (cornerX, cornerY) and (cornerX, 50-cornerY).
				const lTopA = Math.atan2(cornerY - 25, cornerX - 5.25);
				const lBotA = Math.atan2(50 - cornerY - 25, cornerX - 5.25);
				g.arc(5.25, 25, arcR, lTopA, lBotA).stroke({
					color: COURT_LINE,
					width: lw,
				});
				g.rect(0, cornerY - lw / 2, cornerX, lw).fill(COURT_LINE);
				g.rect(0, 50 - cornerY - lw / 2, cornerX, lw).fill(COURT_LINE);

				// Right arc: rim center (88.75, 25). Endpoints at (94-cornerX, cornerY) and (94-cornerX, 50-cornerY).
				const rRimX = 88.75;
				const rTopA = Math.atan2(cornerY - 25, 94 - cornerX - rRimX);
				const rBotA = Math.atan2(50 - cornerY - 25, 94 - cornerX - rRimX);
				// Go from top angle through Math.PI to bot angle (the back of the arc).
				// Easier: stroke from rTopA going CCW around to rBotA via PI.
				g.arc(rRimX, 25, arcR, rTopA, rBotA, true).stroke({
					color: COURT_LINE,
					width: lw,
				});
				g.rect(94 - cornerX, cornerY - lw / 2, cornerX, lw).fill(COURT_LINE);
				g.rect(94 - cornerX, 50 - cornerY - lw / 2, cornerX, lw).fill(
					COURT_LINE,
				);

				// Backboards + rims.
				g.rect(4, 22, 0.18, 6).fill(COURT_BACKBOARD);
				g.rect(89.82, 22, 0.18, 6).fill(COURT_BACKBOARD);
				g.circle(5.25, 25, 0.75).stroke({ color: COURT_RIM, width: 0.2 });
				g.circle(88.75, 25, 0.75).stroke({ color: COURT_RIM, width: 0.2 });

				world.addChildAt(g, 0);
				courtGfx = g;
			}
			// Initial draw with neutral wood-tone paints; gameStart will redraw with the
			// real team colors.
			drawCourt(0x8a6a3e, 0x8a6a3e);

			// ── Court catalog ─────────────────────────────────────────────────────────
			// Per-team court images live in /simcast/static/courts/. The manifest maps
			// each NBA abbrev to a list of variants (modern + season-ranged historical).
			// When a textured court is available for the home team we use it; otherwise
			// we fall back to the procedural court rendered above.
			let courtManifest = null;
			async function loadCourtManifest() {
				try {
					const res = await fetch("/simcast/static/courts/manifest.json");
					if (!res.ok) throw new Error("manifest not ok");
