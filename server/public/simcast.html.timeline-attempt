						return;
					}
					pendingMotion.push(setTimeout(tick, 45));
				};
				pendingMotion.push(setTimeout(tick, 45));
			}

			function ballArcTo(x, y, dur = 0.6, peak = 4) {
				const start =
					ball.carrier && players[ball.carrier]
						? { x: players[ball.carrier].x, y: players[ball.carrier].y }
						: { x: ball.x, y: ball.y };
				ballArcs.push({
					x0: start.x,
					y0: start.y,
					x1: x,
					y1: y,
					peak,
					t0: now,
					dur,
				});
				ball.carrier = null;
			}

			// Each possession picks a play type AND a per-role variant index. Re-rolled
			// on possession changes (drb/stl/tov/made-FG), not on every shot — so the
			// offense looks consistent throughout a single trip down the floor.
			let currentPlay = "set";
			let currentSet = { PG: 0, SG: 0, SF: 0, PF: 0, C: 0 };
			function rollPlay() {
				currentPlay = PLAY_TYPES[Math.floor(Math.random() * PLAY_TYPES.length)];
				for (const role of Object.keys(currentSet)) {
					const spots = PLAY_PLAYBOOK[currentPlay]?.[role] ?? [[0, 25]];
					currentSet[role] = Math.floor(Math.random() * spots.length);
				}
			}

			// Cached target positions for offensive players for the current set.
			// Populated in reformOffense; consumed by reformDefense so defenders mark
			// where their man is GOING, not where they currently are (offense and defense
			// reform tweens fire in the same frame).
			let offensiveTargets = {}; // pid → [x, y]

			// Pending setTimeout ids for off-ball motion (cuts, screener rolls). Cleared
			// on each game start so stale motions from the previous game don't fire.
			let pendingMotion = [];

			// Debug ring-buffer of recent shot attempts (origin, target hoop, side) —
			// inspect via window.__SHOTS to verify hoop-correctness + shot realism.
			const __SHOTS = [];
			window.__SHOTS = __SHOTS;

			// Freelance ball-movement timers, tracked separately so a fired shot can
			// cancel any still-pending passes. `swingToken` invalidates callbacks that
			// were already scheduled when a new shot/possession supersedes them.
			let swingTimers = [];
			let swingToken = 0;
			function clearSwing() {
				for (const id of swingTimers) clearTimeout(id);
				swingTimers = [];
				swingToken++;
			}

			function clearPendingMotion() {
				for (const id of pendingMotion) clearTimeout(id);
				pendingMotion = [];
				clearSwing();
			}

			// Players that the next reform should leave alone (e.g. inbounder mid-animation).
			// Cleared at the start of each reform pass.
			const reformExclude = new Set();

			// Animate an inbound: inbounder for the receiving team stands on the apron
			// at the OOB spot, pass arcs to a receiver near halfcourt, receiver brings
			// the ball up. The next event takes over once this completes.
			//
			//   inboundT  — team that gets the ball
			//   fromX/Y   — court coords where the ball went out of play (or 0 for
			//               make-inbounds: the rim the scoring team attacked)
			//   reason    — "make" | "tov" | "oob"; influences baseline-vs-sideline choice
			function scheduleInbound({ inboundT, fromX, fromY, reason = "make" }) {
				if (inboundT === undefined || inboundT === null) return;
				// Pick the inbounder — usually the PG (typical NBA inbounder role).
				const inbounder =
					onCourt[inboundT].find((pid) => roleOf(pid, inboundT) === "PG") ??
					onCourt[inboundT][0];
				if (inbounder === undefined) return;
				// Pick a receiver — SG or SF, preferring the one furthest from the inbounder.
				const candidates = onCourt[inboundT].filter(
					(pid) =>
						pid !== inbounder && ["SG", "SF"].includes(roleOf(pid, inboundT)),
				);
				const receiver = candidates[0] ?? onCourt[inboundT][1];

				// Decide baseline vs. sideline. Makes are always baseline (under the rim
				// the scoring team attacked). For tov/oob: if the ball went near a baseline
				// AND in the lane, inbound there; otherwise nearest sideline.
				let baselineX, baselineY, receiverX, receiverY;
				if (reason === "make") {
					// fromX is the rim the scoring team attacked; inbound team takes it
					// out from that baseline.
					const dir = fromX > 47 ? 1 : -1; // direction into the apron
					const baseX = fromX > 47 ? 94 : 0;
					baselineX = baseX + dir * 3; // 3 ft into the apron
					baselineY = 25 + rand(-3, 3);
					receiverX = dir > 0 ? 78 : 16; // outlet ~16 ft into the floor
					receiverY = 18;
				} else {
					// Turnover or true OOB. Use fromX/fromY directly.
					const nearBaselineLeft = fromX < 5;
					const nearBaselineRight = fromX > 89;
					const inLane = fromY > 17 && fromY < 33;
					if ((nearBaselineLeft || nearBaselineRight) && inLane) {
						// Baseline inbound.
						const dir = nearBaselineRight ? 1 : -1;
						baselineX = (nearBaselineRight ? 94 : 0) + dir * 3;
						baselineY = clamp(fromY + rand(-4, 4), 2, 48);
						receiverX = dir > 0 ? 78 : 16;
						receiverY = clamp(fromY + rand(-6, 6), 6, 44);
					} else {
						// Sideline inbound — inbounder stands 3 ft past the nearest sideline.
						const sideDir = fromY < 25 ? -1 : 1; // -1 = top sideline, +1 = bottom
						baselineX = clamp(fromX, 4, 90);
						baselineY = (sideDir < 0 ? 0 : 50) + sideDir * 3;
						// Receiver in the offensive half on the same lateral side.
						const offHalfDir = inboundT === 0 ? 1 : -1; // team 0 attacks right
						receiverX = offHalfDir > 0 ? 64 : 30;
						receiverY = clamp(fromY + (sideDir < 0 ? 8 : -8), 10, 40);
					}
				}

				reformExclude.add(inbounder);
				if (receiver !== undefined) reformExclude.add(receiver);
				inboundActive = true; // drain defers its swing until the end-beat below

				// Suspend the event drain for the inbound. An inbound + bring-up spans ~5
				// game-seconds; convert that to real time at the CURRENT playback pace so a
				// fast BBGM speed gives a snappy inbound and a slow one lingers. When simcast
				// is already trailing BBGM (fast-forward), collapse it to almost nothing so
				// it never holds the drain back from catching up. inbScale rescales all the
				// internal beats below so the whole inbound compresses/expands as one unit.
				const effRate = gameRate * speed;
				const lagNow = bbgmLagSeconds(eventQueue[0] ?? null);
				const INBOUND_DURATION_MS =
					lagNow > CATCHUP_THRESH
						? 320
						: clamp((5 / effRate) * 1000, 650, 3000);
				const inbScale = INBOUND_DURATION_MS / 2400;
				nextEarliestMs = Math.max(
					nextEarliestMs,
					performance.now() + INBOUND_DURATION_MS,
				);

				// Pre-stage the 3 non-inbounder team members at NEW offensive role spots,
				// and all 5 defenders at their defensive matchup spots. possessionTeam may
				// not have flipped yet — we know inboundT is the new offense.
				rollPlay();
				const defT = inboundT === 0 ? 1 : 0;
				const defRim = defendedRimX(defT);
				for (const pid of onCourt[inboundT]) {
					if (pid === inbounder || pid === receiver) continue;
					const role = roleOf(pid, inboundT);
					const [tx, ty] = offensiveRoleSpot(
						inboundT,
						role,
						currentSet[role] ?? 0,
					);
					moveTo(
						pid,
						tx + rand(-2, 2),
						ty + rand(-2, 2),
						Math.max(0.3, 2.2 * inbScale),
						"sprint",
					);
				}
				for (const pid of onCourt[defT]) {
					const role = roleOf(pid, defT);
					const [ox, oy] = offensiveRoleSpot(
						inboundT,
						role,
						currentSet[role] ?? 0,
					);
					// Defender on the man→rim line, 6 ft toward the rim from man.
					const dx = defRim - ox,
						dy = 25 - oy;
					const dl = Math.hypot(dx, dy) || 1;
					const tx = ox + (dx / dl) * 6;
					const ty = oy + (dy / dl) * 6;
					moveTo(
						pid,
						clamp(tx + rand(-1, 1), 1, 93),
						clamp(ty + rand(-1, 1), 1, 49),
						Math.max(0.3, 2.2 * inbScale),
						"sprint",
					);
				}

				// Inbound beats, timed as fractions of the inbound window D so the OOB
				// inbound actually READS: the inbounder steps out of bounds onto the apron,
				// HOLDS the ball there for a clear beat, passes it in to the outlet, then
				// steps back in-bounds and joins the play. (The old timeline gave the apron
				// only ~0.1s before the pass, so the inbound never looked like it happened
				// out of bounds.)
				const D = INBOUND_DURATION_MS;

				// t ≈ 0.04·D: the inbounder is handed the ball already out of bounds — place
				// them ON the apron (a snap, not a glide, so they truly reach OOB at any pace
				// instead of drifting a half-step and passing from in-bounds). The ball rides
				// with them, so it's visibly an out-of-bounds inbound. The outlet breaks open.
				pendingMotion.push(
					setTimeout(() => {
						ball.carrier = inbounder;
						snapPlayer(inbounder, baselineX, baselineY);
						if (receiver !== undefined) {
							moveTo(
								receiver,
								receiverX,
								receiverY,
								Math.max(0.4, 0.0002 * D),
								"sprint",
							);
						}
					}, 0.04 * D),
				);

				// t ≈ 0.64·D: the pass in — after a clear hold on the apron, the ball arcs
				// from the inbounder's OOB position to the outlet.
				pendingMotion.push(
					setTimeout(() => {
						if (receiver !== undefined && players[receiver]) {
							const r = players[receiver];
							ballArcTo(r.x, r.y, 0.45, 2);
						}
					}, 0.64 * D),
				);

				// t ≈ 0.78·D: the inbounder steps back in-bounds and heads to their own
				// offensive role spot so they join the play instead of standing on the apron.
				pendingMotion.push(
					setTimeout(() => {
						const role = roleOf(inbounder, inboundT);
						const [tx, ty] = offensiveRoleSpot(
							inboundT,
							role,
							currentSet[role] ?? 0,
						);
						moveTo(
							inbounder,
							clamp(tx + rand(-2, 2), 1, 93),
							clamp(ty + rand(-2, 2), 1, 49),
							Math.max(0.4, 0.0004 * D),
							"sprint",
						);
					}, 0.78 * D),
				);

				// t ≈ 0.92·D: receiver takes possession; release the inbound exclusion and
				// replan the rest of the gap so the offense flows straight into the set.
				pendingMotion.push(
					setTimeout(() => {
						if (receiver !== undefined) ball.carrier = receiver;
						reformExclude.clear();
						inboundActive = false;
						replanCurrentGap();
					}, 0.92 * D),
				);

				// Debug: verify the inbounder actually reaches the apron (out of bounds).
				window.__INB = {
					inbounder,
					reason,
					baselineX: +baselineX.toFixed(1),
					baselineY: +baselineY.toFixed(1),
				};
				pendingMotion.push(
					setTimeout(() => {
						const p = players[inbounder];
						if (p && window.__INB) {
							window.__INB.actualX = +p.x.toFixed(1);
							window.__INB.actualY = +p.y.toFixed(1);
							window.__INB.onApron =
								p.x > 94 || p.x < 0 || p.y > 50 || p.y < 0;
						}
					}, 0.4 * D),
				);
			}

			// Decide whether a make event should trigger an inbound. FGs always; FTs only
			// when it's the LAST FT of the trip (next event isn't another FT for the same team).
			function shouldInboundAfter(ev) {
				// Made FG (any 2/3pt make) — match fg* and tp* but not fga*.
				if (
					typeof ev.type === "string" &&
					/^(fg|tp)[A-Z]?/.test(ev.type) &&
					!ev.type.startsWith("fga")
				) {
					return true;
				}
				if (ev.type === "ft") {
					const next = eventQueue[0];
					if (!next) return true;
					if ((next.type === "ft" || next.type === "missFt") && next.t === ev.t)
						return false;
					return true;
				}
				return false;
			}

			// Cut/screen layer deleted — variety now comes from planMotion's per-event
			// targets (assister staging, paint pre-reach for at-rim shots, role-spot
			// jitter per possession). Separate cut scheduling fought with planner targets.

			// reformOffense / reformDefense were superseded by planMotion + buildRoleTargets.
			// Their role/spot logic now lives in buildRoleTargets which is called by
			// planMotion before any moveTo fires — letting the planner override specific
			// players (assister, paint-pre-staging shooter) before tweens are queued.

			// ── Lookahead positioning ─────────────────────────────────────────────────
			const FGA_TYPES = new Set([
				"fgaAtRim",
				"fgaLowPost",
				"fgaMidRange",
				"fgaTp",
				"fgaTpFake",
				"fgaTipIn",
				"fgaPutBack",
			]);

			// targetForNextEvent removed — its responsibilities are now in planMotion's
			// per-event switch (sees both `next` and `next2` for richer staging).

			// ── Motion planner (Phase 3.5 velocity-budgeted) ──────────────────────────
			// Builds per-role base targets without firing tweens. Mirrors the role/spot
			// logic from reformOffense+reformDefense so the planner can override specific
			// players' targets before any tween is queued.
			// Match each defender to the offensive player they should guard, by ROLE.
			// Falls back to slot index when role distributions don't line up exactly
			// (e.g. two offensive PGs after a sub creates a positional mismatch).
			const ROLE_PRIORITY = { PG: 0, SG: 1, SF: 2, PF: 3, C: 4 };
			function buildMatchups(offT, defT) {
				// Map: offensive pid → defensive pid
				const offByRole = {};
				for (const pid of onCourt[offT]) {
					const r = roleOf(pid, offT);
					(offByRole[r] ??= []).push(pid);
				}
				const matchups = {};
				const usedDef = new Set();
				for (const dpid of onCourt[defT]) {
					const r = roleOf(dpid, defT);
					const candidates = offByRole[r];
					if (candidates && candidates.length > 0) {
						// Take the first unmatched offensive player of this role.
						const opid = candidates.shift();
						matchups[opid] = dpid;
						usedDef.add(dpid);
					}
				}
				// Any unmatched defender — assign to any unmatched offensive player in
				// role-priority order so we still have full coverage after sub mismatches.
				const unmatchedOff = onCourt[offT].filter(
					(opid) => !(opid in matchups),
				);
				const unmatchedDef = onCourt[defT].filter((dpid) => !usedDef.has(dpid));
				unmatchedOff.sort(
					(a, b) =>
						(ROLE_PRIORITY[roleOf(a, offT)] ?? 5) -
						(ROLE_PRIORITY[roleOf(b, offT)] ?? 5),
				);
				unmatchedDef.sort(
					(a, b) =>
						(ROLE_PRIORITY[roleOf(a, defT)] ?? 5) -
						(ROLE_PRIORITY[roleOf(b, defT)] ?? 5),
				);
				for (
					let i = 0;
					i < Math.min(unmatchedOff.length, unmatchedDef.length);
					i++
				) {
					matchups[unmatchedOff[i]] = unmatchedDef[i];
				}
				return matchups;
			}

			// Push two points apart until they're at least `minDist` ft from each other.
			// Used to enforce realistic NBA spacing — no two offensive players within
			// arm's reach.
			function enforceMinSpacing(targets, pids, minDist, skipPairs) {
				// Few iterations of pairwise push — converges quickly for 5 players.
				for (let iter = 0; iter < 4; iter++) {
					let moved = false;
					for (let i = 0; i < pids.length; i++) {
						for (let j = i + 1; j < pids.length; j++) {
							// A guarded pair (an offensive player and the defender assigned to
							// him) is SUPPOSED to be close — pushing it apart breaks the matchup.
							if (skipPairs) {
								const lo = Math.min(pids[i], pids[j]),
									hi = Math.max(pids[i], pids[j]);
								if (skipPairs.has(lo + "|" + hi)) continue;
							}
							const a = targets[pids[i]],
								b = targets[pids[j]];
							if (!a || !b) continue;
							const dx = b.x - a.x,
								dy = b.y - a.y;
							const d = Math.hypot(dx, dy);
							if (d < minDist && d > 0.01) {
								const push = (minDist - d) / 2 + 0.05;
								const ux = dx / d,
									uy = dy / d;
								a.x -= ux * push;
								a.y -= uy * push;
								b.x += ux * push;
								b.y += uy * push;
								moved = true;
							}
						}
					}
					if (!moved) break;
				}
			}

			function buildRoleTargets(offT, defT, mode) {
				const targets = {}; // pid → { x, y, urgency }
				offensiveTargets = {};

				// Offense — place each player at their role spot for the current play.
				for (const pid of onCourt[offT]) {
					const role = roleOf(pid, offT);
					const [x, y] =
						mode === "ft"
							? ftRoleSpot(offT, role, true)
							: offensiveRoleSpot(offT, role, currentSet[role] ?? 0);
					const jx = x + rand(-2.5, 2.5);
					const jy = y + rand(-2.5, 2.5);
					offensiveTargets[pid] = [x, y];
					// Sprint urgency only raises the reachability cap — actual on-screen speed
					// is still distance/gap — so far-side players reform fully instead of
					// stalling mid-court and leaving the offense bunched.
					targets[pid] = { x: jx, y: jy, urgency: "sprint" };
				}

				// Tighter offense spacing (NBA stand-around is 12–15 ft).
				if (mode !== "ft") {
					enforceMinSpacing(targets, onCourt[offT], 12);
					for (const pid of onCourt[offT]) {
						if (targets[pid])
							offensiveTargets[pid] = [targets[pid].x, targets[pid].y];
					}
				}

				// Defense — unit-vector man→rim with helpside sag.
				const myRim = defendedRimX(defT);
				const myRimY = 25;
				let matchups = null;
				if (mode === "ft") {
					for (const pid of onCourt[defT]) {
						const role = roleOf(pid, defT);
						const [x, y] = ftRoleSpot(offT, role, false);
						targets[pid] = {
							x: x + rand(-0.6, 0.6),
							y: y + rand(-0.6, 0.6),
							urgency: "walk",
						};
					}
				} else {
					matchups = buildMatchups(offT, defT);
					// Identify ball-carrier position to detect strong/weak side.
					let ballX = null,
						ballY = null;
					const carrierPid = ball.carrier;
					if (carrierPid !== null && offensiveTargets[carrierPid]) {
						[ballX, ballY] = offensiveTargets[carrierPid];
					}
					for (const opid of Object.keys(matchups)) {
						const dpid = matchups[opid];
						const xy = offensiveTargets[opid];
						if (!xy) continue;
						const [manX, manY] = xy;
						const isOnBall = Number(opid) === carrierPid;
						const ballDist =
							ballX !== null ? Math.hypot(manX - ballX, manY - ballY) : 0;
						const isWeakside = Math.abs(manY - 25) > 16 && ballDist > 30;
						// Place defender on the man→rim line, helping toward the rim.
						const dxRim = myRim - manX,
							dyRim = myRimY - manY;
						const dlen = Math.hypot(dxRim, dyRim) || 1;
						const ux = dxRim / dlen,
							uy = dyRim / dlen;
						const helpDist = isOnBall ? 3 : isWeakside ? 9 : 6;
						const helpY = isWeakside ? (manY > 25 ? -2 : 2) : 0;
						let tx = manX + ux * helpDist;
						let ty = manY + uy * helpDist + helpY;
						// Cap defender-to-man distance at 8 ft (no 20-ft sags except weakside,
						// which is gated by helpDist above).
						const dToMan = Math.hypot(tx - manX, ty - manY);
						if (dToMan > 8) {
							const k = 8 / dToMan;
							tx = manX + (tx - manX) * k;
							ty = manY + (ty - manY) * k;
						}
						// Clamp inside the playing surface so defenders don't park in the apron.
						tx = clamp(tx, 1, 93);
						ty = clamp(ty, 1, 49);
						targets[dpid] = {
							x: tx + rand(-1, 1),
							y: ty + rand(-1, 1),
							urgency: "sprint",
						};
					}
				}

				// Final 10-player spacing pass — no two players ever target overlapping
				// positions. Runs after both offense + defense are placed so we catch
				// off-ball defenders bumping into each other or into their own teammates.
				// Guarded matchups (offensive player ↔ his defender) are exempt: a defender
				// belongs right on his man, so the pass must not shove them apart.
				if (mode !== "ft") {
					const allPids = [...onCourt[offT], ...onCourt[defT]].map(Number);
					const skipPairs = new Set();
					if (matchups) {
						for (const opid of Object.keys(matchups)) {
							const o = Number(opid),
								d = matchups[opid];
							skipPairs.add(Math.min(o, d) + "|" + Math.max(o, d));
						}
					}
					enforceMinSpacing(targets, allPids, 4, skipPairs);
				}
				return targets;
			}

			// True iff this event is a made FG/3pt (not an attempt).
			function isMakeEvent(ev) {
				return (
					typeof ev?.type === "string" &&
					/^(fg|tp)[A-Z]?/.test(ev.type) &&
					!ev.type.startsWith("fga")
				);
			}
			function isFgaEvent(ev) {
				return typeof ev?.type === "string" && FGA_TYPES.has(ev.type);
			}

			// Plan motion for the upcoming interval. Returns:
			//   { movers: [{ pid, x, y, urgency }], ballCarrier, ballArc? }
			// Reads `next` (event being approached) and `next2` (the one after) so
			// makes-with-pidAst can stage the assister at a realistic passing spot, and
			// rebounds can pre-stage the next shooter mid-fastbreak.
			function planMotion(next, next2, gap) {
				// Formation must be built around the team that actually finishes this
				// possession. For a shot/FT/turnover that's authoritatively next.t — trust
				// it over the drift-prone possessionTeam so the offense fills offensive
				// spots and defenders guard them (not the inverted arrangement that put a
				// defender on the ball at the offense's rim).
				const offT =
					isFgaEvent(next) ||
					next.type === "ft" ||
					next.type === "missFt" ||
					next.type === "tov"
						? next.t
						: possessionTeam;
				const defT = offT === 0 ? 1 : 0;
				const mode =
					next.type === "ft" || next.type === "missFt" ? "ft" : "set";

				const targets = buildRoleTargets(offT, defT, mode);
				let ballCarrier = null;
				let ballArc = null;

				// 1) The fga* case — shooter sprints to shot spot. If next2 is a made FG
				//    with pidAst, place the assister at a passing-distance spot from the
				//    shooter and have the ball follow them until just before the make.
				if (isFgaEvent(next)) {
					const shooter = next.pid;
					const [sx, sy] = shotSpotFor(next);
					targets[shooter] = { x: sx, y: sy, urgency: "sprint" };

					if (
						next2 &&
						isMakeEvent(next2) &&
						next2.pidAst !== undefined &&
						players[next2.pidAst]
					) {
						const assister = next2.pidAst;
						// Pass spot: along the (shooter → away-from-rim) line, 15-22 ft out,
						// with a perpendicular jitter so the pass isn't dead-straight.
						const rim = attackRimX(next.t);
						const awayX = sx - (rim - sx) * 0.5; // step further from rim
						const awayY = sy + rand(-4, 4);
						const dist =
							ASSIST_PASS_DIST_MIN +
							Math.random() * (ASSIST_PASS_DIST_MAX - ASSIST_PASS_DIST_MIN);
						const vx = awayX - sx,
							vy = awayY - sy;
						const vlen = Math.hypot(vx, vy) || 1;
						const px = sx + (vx / vlen) * dist;
						const py = sy + (vy / vlen) * dist;
						targets[assister] = { x: px, y: py, urgency: "jog" };
						ballCarrier = assister;
						ballArc = { x: sx, y: sy, dur: 0.4, peak: 4 };
					} else {
						ballCarrier = shooter;
					}
				}

				// 2) Free throw — shooter walks to the line.
				else if (mode === "ft") {
					const rim = attackRimX(next.t);
					const dir = attackDir(next.t);
					targets[next.pid] = { x: rim + dir * 14, y: 25, urgency: "walk" };
					ballCarrier = next.pid;
				}

				// 3) Rebound — rebounder sprints to the rim. If next2 is a fga*, the next
				//    shooter pre-stages during this gap so they're not 60 ft away at fire.
				else if (next.type === "drb" || next.type === "orb") {
					// The missed shot was at the rebounder's OWN attack rim on an offensive
					// board, or the rim they defend on a defensive board.
					const reboundRimX =
						next.type === "orb" ? attackRimX(next.t) : defendRimX(next.t);
					const offset = reboundRimX > 47 ? -3 : 3;
					targets[next.pid] = {
						x: reboundRimX + offset,
						y: 25 + rand(-3, 3),
						urgency: "sprint",
					};

					if (next2 && isFgaEvent(next2)) {
						const [nx, ny] = shotSpotFor(next2);
						targets[next2.pid] = { x: nx, y: ny, urgency: "jog" };
					}
					ballCarrier = next.pid;
				}

				// 4) Steal — thief sprints to where the ball-handler was; pre-stage next shooter.
				else if (next.type === "stl") {
					const tovPl = players[next.pidTov];
					if (tovPl)
						targets[next.pid] = { x: tovPl.x, y: tovPl.y, urgency: "sprint" };
					if (next2 && isFgaEvent(next2)) {
						const [nx, ny] = shotSpotFor(next2);
						targets[next2.pid] = { x: nx, y: ny, urgency: "sprint" };
					}
					ballCarrier = next.pid;
				}

				// 5) Jump ball — both centers walk to center court.
				else if (next.type === "jumpBall") {
					targets[next.pid] = { x: 47, y: 25, urgency: "jog" };
					targets[next.pid2] = { x: 47, y: 25, urgency: "jog" };
				}

				// 6) Paint reachability — if next2 is an at-rim/tip-in/putback, drag the
				//    relevant shooter toward the paint regardless of their role spot.
				if (
					next2 &&
					isFgaEvent(next2) &&
					(next2.type === "fgaAtRim" ||
						next2.type === "fgaTipIn" ||
						next2.type === "fgaPutBack")
				) {
					// Drag the upcoming shooter to the exact cached shot spot in the paint.
					if (targets[next2.pid]) {
						const [px, py] = shotSpotFor(next2);
						targets[next2.pid] = { x: px, y: py, urgency: "sprint" };
					}
				}

				const movers = [];
				for (const [pid, t] of Object.entries(targets)) {
					movers.push({ pid: Number(pid), x: t.x, y: t.y, urgency: t.urgency });
				}
				return { movers, ballCarrier, ballArc };
			}

			// ── Inter-event pacing context (so scheduleInbound's deferred callback can
			//    replan with whatever real time is left in the current gap).
			let pacingCtx = { prev: null, gapStartedAt: 0, gap: 0, gapGame: 0 };
			// True while an inbound animation owns the ball — the drain's setupNextInterval
			// then defers the pass-swing to the inbound's own end-beat (replanCurrentGap) so
			// the two don't fight over ball.carrier.
			let inboundActive = false;

			// Freelance ball movement: instead of the ball sitting glued to one player
			// for the whole possession, swing it around the offense — a chain of passes
			// that ends in the shooter's hands right as they fire. Returns true when a
			// swing was scheduled (caller then skips its own ball-carrier assignment).
			function maybeBallSwing(next, gapSec, gapGameSec) {
				clearSwing();
				if (!next) return false;
				// Decide in GAME-seconds (speed-independent): any possession with a few
				// seconds of clock to burn gets its ball swung around the offense — a chain
				// of passes that lands in the finisher's hands right as the event fires.
				// Short trips (fast breaks, putbacks, tip-ins) skip straight to the finish.
				// This is what fills an "inbound → score 15 seconds later" with real passes
				// instead of a frozen possession. Covers shots AND turnovers AND dead time.
				const game = typeof gapGameSec === "number" ? gapGameSec : gapSec;
				if (game < 3 || gapSec < 0.6) return false;

				// The team that FINISHES this possession is authoritatively `next.t` for a
				// shot or turnover. Trust that over the separately-tracked possessionTeam,
				// which can drift — and when it does, the ball was swinging among the WRONG
				// team, so a defender ended up holding it and "shooting on the offense's
				// basket." Fall back to possessionTeam for non-finishing events.
				const authOff =
					isFgaEvent(next) || next.type === "tov" ? next.t : possessionTeam;
				if (authOff !== possessionTeam) {
					window.__ANOM = window.__ANOM || [];
					window.__ANOM.push({
						kind: "swingOffT drift",
						nextType: next.type,
						nextT: next.t,
						possessionTeam,
						period: currentPeriod,
					});
				}
				const offT = authOff;
				const offPids = onCourt[offT].filter((p) => players[p]);
				if (offPids.length < 3) return false;

				// Who ends the possession, if we know: the shooter, or the giveaway man on a
				// turnover. Otherwise the ball just circulates and dies with the PG.
				let ender = null;
				if (isFgaEvent(next) && players[next.pid] && players[next.pid].t === offT) {
					ender = next.pid;
				} else if (
					next.type === "tov" &&
					players[next.pid] &&
					players[next.pid].t === offT
				) {
					ender = next.pid;
				}

				// Start the chain with whoever already holds the ball, else the PG.
				const holder =
					ball.carrier !== null && offPids.includes(ball.carrier)
						? ball.carrier
						: (offPids.find((p) => roleOf(p, offT) === "PG") ?? offPids[0]);
				const endAt =
					ender ?? offPids.find((p) => roleOf(p, offT) === "PG") ?? offPids[0];

				// Fewer, purposeful touches — a calm swing, not a frantic volley. Only
				// 0–2 intermediate passes (often just holder → shooter), and order the
				// passers by angle around the attacking rim so the ball rotates smoothly
				// around the perimeter with short adjacent passes instead of criss-crossing
				// the floor to random men — the old shuffle is what looked wonky.
				const nMid = clamp(Math.round(game / 7), 0, 2);
				const rimX = attackRimX(offT);
				const angOf = (p) =>
					Math.atan2((players[p]?.y ?? 25) - 25, (players[p]?.x ?? 47) - rimX);
				// Frontcourt/backcourt geometry (period-aware via attackRimX). Once the
				// offense has advanced, the ball must NOT be swung back across midcourt to
				// a teammate in the backcourt — an over-and-back. Only allow backcourt
				// targets while the ball is still being brought up (holder still in the
				// backcourt). A real over-and-back is a turnover event, never a swing.
				const attackingLeft = rimX < 47;
				const inBackcourt = (p) => {
					const x = players[p]?.x ?? 47;
					return attackingLeft ? x > 51 : x < 43; // 4 ft grace past midcourt
				};
				const holderBack = inBackcourt(holder);
				const pool = offPids
					.filter((p) => p !== holder && p !== endAt)
					.filter((p) => holderBack || !inBackcourt(p))
					.sort((a, b) => angOf(a) - angOf(b));
				// Rotate the sorted ring to begin just past the holder's angle so the swing
				// sweeps around toward the finisher rather than jumping back and forth.
				const holderAng = angOf(holder);
				let startIdx = pool.findIndex((p) => angOf(p) >= holderAng);
				if (startIdx < 0) startIdx = 0;
				const ordered =
					startIdx > 0
						? [...pool.slice(startIdx), ...pool.slice(0, startIdx)]
						: pool;
				const chain = [holder, ...ordered.slice(0, nMid), endAt].filter(
					(p, i, a) => i === 0 || p !== a[i - 1],
				);
				if (chain.length < 2) return false;

				ball.carrier = chain[0];
				const tok = swingToken;
				const nPass = chain.length - 1;
				// Known finisher → last pass lands at ~0.86 of the gap (a beat before the
				// shot/turnover). Unknown → let the ball keep moving almost to the buzzer.
				const tStart = gapSec * 0.15,
					tEnd = gapSec * (ender ? 0.86 : 0.95);
				for (let k = 1; k < chain.length; k++) {
					const frac =
						nPass === 1
							? tEnd
							: tStart + (tEnd - tStart) * ((k - 1) / (nPass - 1));
					const from = chain[k - 1],
						to = chain[k];
					const id = setTimeout(
						() => {
							// Skip while paused so a mid-flight pass can't pop the ball to a new
							// (frozen) carrier — the sim-clock is halted, motion must be too.
							if (tok !== swingToken || gameOver || paused) return;
							const a = players[from],
								b = players[to];
							if (!a || !b) return;
							// Safety net if a receiver drifted into the backcourt since the chain
							// was planned: never complete a frontcourt->backcourt pass (over-and-
							// back). Keep the ball with the frontcourt passer; the finisher still
							// gets it at shot time via the fga handler.
							const aBack = attackingLeft ? a.x > 51 : a.x < 43;
							const bBack = attackingLeft ? b.x > 51 : b.x < 43;
							if (!aBack && bBack) return;
							ballArcs.length = 0;
							ballArcs.push({
								x0: a.x + a.r * 0.8,
								y0: a.y - a.r * 0.4,
								x1: b.x,
								y1: b.y,
								peak: 2.6,
								t0: now,
								dur: 0.4,
							});
							ball.carrier = null;
							const id2 = setTimeout(() => {
								if (tok === swingToken && !gameOver && !paused && players[to])
									ball.carrier = to;
							}, 410);
							swingTimers.push(id2);
						},
						Math.max(0, frac * 1000),
					);
					swingTimers.push(id);
				}
				return true;
			}

			function setupNextInterval(next, next2, gap, gapGame) {
				if (!next) return;
				const plan = planMotion(next, next2, gap);

				// Use the full gap as the tween duration — players move the entire interval,
				// velocity-clamped, instead of snapping in fractions of it.
				for (const m of plan.movers) {
					if (reformExclude.has(m.pid)) continue;
					// Players with a long way to travel (transition — especially defenders
					// getting back on defense) HUSTLE into position and arrive early, then
					// hold — instead of ambling the target across the whole (possibly long)
					// gap at distance/gap speed, which looked like nobody sprinting back.
					const pl = players[m.pid];
					let dur = gap;
					if (pl) {
						const dist = Math.hypot(m.x - pl.x, m.y - pl.y);
						if (dist > 16) dur = Math.min(gap, dist / 17); // ~17 ft/s hustle
					}
					moveTo(m.pid, m.x, m.y, dur, m.urgency);
				}
				// A swing supersedes the planner's single ball assignment / assist arc.
				// While an inbound owns the ball, defer the swing to the inbound's end-beat
				// (replanCurrentGap) so they don't both drive ball.carrier at once.
				if (!inboundActive && maybeBallSwing(next, gap, gapGame)) return;
				if (plan.ballCarrier !== null && players[plan.ballCarrier]) {
					ball.carrier = plan.ballCarrier;
				}
				if (plan.ballArc) {
					const leadMs = Math.max(0, (gap - PASS_LEAD_SEC) * 1000);
					pendingMotion.push(
						setTimeout(() => {
							ballArcTo(
								plan.ballArc.x,
								plan.ballArc.y,
								plan.ballArc.dur,
								plan.ballArc.peak,
							);
						}, leadMs),
					);
				}
			}

			// Replan toward the next queued event with whatever real time is left in the
			// current gap. Used by the tipoff and inbound handlers, which suspend the
			// drain while their own animation plays and must hand motion back afterward.
			function replanCurrentGap() {
				if (gameOver) return;
				const elapsedSec = (performance.now() - pacingCtx.gapStartedAt) / 1000;
				const remaining = Math.max(MIN_DUR, pacingCtx.gap - elapsedSec);
				// Game-seconds still ahead in this possession, proportional to real time left.
				const remainingGame =
					pacingCtx.gap > 0
						? pacingCtx.gapGame * (remaining / pacingCtx.gap)
						: pacingCtx.gapGame;
				const upNext = eventQueue[0],
					upNext2 = eventQueue[1];
				if (!upNext) return;
				const plan = planMotion(upNext, upNext2, remaining);
				for (const m of plan.movers) {
					if (reformExclude.has(m.pid)) continue;
					// Players with a long way to travel (transition — especially defenders
					// getting back on defense) HUSTLE into position and arrive early, then
					// hold — instead of ambling the target across the whole (possibly long)
					// gap at distance/gap speed, which looked like nobody sprinting back.
					const pl = players[m.pid];
					let dur = remaining;
					if (pl) {
						const dist = Math.hypot(m.x - pl.x, m.y - pl.y);
						if (dist > 16) dur = Math.min(remaining, dist / 17); // ~17 ft/s hustle
					}
					moveTo(m.pid, m.x, m.y, dur, m.urgency);
				}
				if (maybeBallSwing(upNext, remaining, remainingGame)) return;
				if (plan.ballCarrier !== null && players[plan.ballCarrier]) {
					ball.carrier = plan.ballCarrier;
				}
			}

			// ── Event → animation interpreter ─────────────────────────────────────────
			function teamLabel(t) {
				return teams[t]?.abbrev ?? `T${t}`;
			}
			function playerName(pid) {
				return players[pid]?.info.name?.split(" ").slice(-1)[0] ?? `#${pid}`;
			}

			function setPlayText(msg) {
				playEl.textContent = msg;
			}
			function setClock(secs) {
				if (typeof secs !== "number") return;
				currentClock = secs;
				const mm = Math.floor(secs / 60);
				const ss = Math.floor(secs % 60);
				clockEl.textContent = `${mm}:${ss.toString().padStart(2, "0")}`;
			}

			function renderStats() {
				const fmt = (s) =>
					`${s.fgm}/${s.fga} FG · ${s.tpm}/${s.tpa} 3P · ${s.ftm}/${s.fta} FT · ${s.reb} reb · ${s.ast} ast`;
				teamStatsEl.innerHTML = `<b>${teamLabel(0)}</b> ${fmt(teamStats[0])}<br><b>${teamLabel(1)}</b> ${fmt(teamStats[1])}`;
			}

			function bumpScore(t, pts) {
				scores[t] += pts;
				(t === 0 ? scoreH : scoreA).textContent = scores[t];
			}

			// Update which team has the ball after this event resolves. When possession
			// flips, roll a new play type so the next trip down the floor looks different.
			function updatePossession(ev, next) {
				if (typeof ev.t !== "number") return;
				const prev = possessionTeam;
				const maybeRoll = () => {
					if (possessionTeam !== prev) rollPlay();
				};
				// Events where ev.t IS the offensive team — possession sits with them.
				if (
					FGA_TYPES.has(ev.type) ||
					ev.type === "drb" ||
					ev.type === "orb" ||
					ev.type === "stl"
				) {
					possessionTeam = ev.t;
					maybeRoll();
					return;
				}
				// Free throws (ev.t = shooter's team). Possession stays with the
				// shooter across a multi-FT trip, but a MADE final free throw is
				// followed by the OTHER team inbounding — so flip when this is a
				// made `ft` and the next event isn't another FT for the same team.
				// A missed final FT is followed by a rebound event that sets
				// possession itself, so missFt always stays with the shooter.
				if (ev.type === "ft" || ev.type === "missFt") {
					const moreFt =
						next &&
						(next.type === "ft" || next.type === "missFt") &&
						next.t === ev.t;
					if (ev.type === "ft" && !moreFt) {
						possessionTeam = ev.t === 0 ? 1 : 0;
					} else {
						possessionTeam = ev.t;
					}
					maybeRoll();
					return;
				}
				// Made FG (any 2pt or 3pt make) — the OTHER team inbounds. The
				// AndOne types (fgAtRimAndOne, tpAndOne, …) also match the regex
				// but the scoring team KEEPS the ball for its bonus free throw,
				// so they are excluded here and fall through unchanged.
				if (
					/^(fg|tp)[A-Z]?/.test(ev.type) &&
					!ev.type.startsWith("fga") &&
					!ev.type.endsWith("AndOne")
				) {
					possessionTeam = ev.t === 0 ? 1 : 0;
					maybeRoll();
					return;
				}
				// Turnover (ev.t = ball-loser): other team gets it.
				if (ev.type === "tov") {
					possessionTeam = ev.t === 0 ? 1 : 0;
					maybeRoll();
					return;
				}
				// Out of bounds (ev.t = team that knocked it out): other team inbounds.
				if (ev.type === "outOfBounds") {
					possessionTeam = ev.t === 0 ? 1 : 0;
					maybeRoll();
					return;
				}
				// Defensive foul (ev.t = fouler): offense keeps/regains the ball.
				if (
					ev.type === "pfFG" ||
					ev.type === "pfTP" ||
					ev.type === "pfBonus" ||
					ev.type === "pfNonShooting"
				) {
					possessionTeam = ev.t === 0 ? 1 : 0;
					maybeRoll();
					return;
				}
			}

			function handleEvent(ev) {
				if (typeof ev.clock === "number") setClock(ev.clock);

				switch (ev.type) {
					case "period": {
						currentPeriod = ev.period;
						quarterEl.textContent =
							currentPeriod <= 4
								? `Q${currentPeriod}`
								: `OT${currentPeriod - 4}`;
						setPlayText(`Start of ${quarterEl.textContent}`);
						// Player positions left as-is; setupNextInterval will move them toward
						// the first action of the new period.
						ball = { x: 47, y: 25, z: 0, carrier: null };
						break;
					}
					case "overtime": {
						currentPeriod = ev.period;
						quarterEl.textContent = `OT${currentPeriod - 4}`;
						setPlayText("Overtime");
						break;
					}
					case "jumpBall": {
						setPlayText(
							`Jump ball · ${playerName(ev.pid)} vs ${playerName(ev.pid2)}`,
						);
						// Full tipoff: jumpers to center, scatter others, ball pops, tip to PG.
						runTipoff();
						break;
					}
					case "fgaAtRim":
					case "fgaLowPost":
					case "fgaMidRange":
					case "fgaTp":
					case "fgaTpFake":
					case "fgaTipIn":
					case "fgaPutBack": {
						// Shooter goes to their (cached, deterministic) spot. Off-ball players
						// were already moving into formation during the previous interval.
						clearSwing(); // cancel any still-pending freelance passes
						ensurePlayer(ev.pid, ev.t); // bench shooter may not be instantiated yet
						const [sx, sy] = shotSpotFor(ev);
						// Debug: log shot origin + target hoop so hoop-correctness and shot
						// realism can be inspected via window.__SHOTS (kept small).
						const rimForShot = attackRimX(ev.t);
						__SHOTS.push({
							period: currentPeriod,
							t: ev.t,
							type: ev.type,
							sx: +sx.toFixed(1),
							sy: +sy.toFixed(1),
							rimX: rimForShot,
							distFromRim: +Math.hypot(sx - rimForShot, sy - RIM_Y).toFixed(1),
							side: rimForShot > 47 ? "RIGHT" : "LEFT",
							// Consistency probes for the "defender shoots on offense's basket"
							// bug: the shooter's CACHED team (drives color) and the tracked
							// possessionTeam must both equal BBGM's authoritative ev.t.
							shooterCachedT: players[ev.pid]?.t,
							poss: possessionTeam,
							teamMismatch:
								players[ev.pid]?.t !== ev.t || possessionTeam !== ev.t,
						});
						if (__SHOTS.length > 40) __SHOTS.shift();
						moveTo(ev.pid, sx, sy, 0.45, "sprint");
						ball.carrier = ev.pid;
						const arcDur =
							ev.type === "fgaTp" || ev.type === "fgaMidRange" ? 0.9 : 0.5;
						const peak =
							ev.type === "fgaTp" ? 14 : ev.type === "fgaMidRange" ? 10 : 5;
						// Launch the shot FROM the shot spot itself, toward the rim this team
						// attacks RIGHT NOW (period-aware), and only once the shooter has
						// actually reached the spot — so the ball never leaves an empty patch
						// of floor while the shooter is still in transit, and a three really
						// leaves from behind the arc, a mid-range from mid-range, etc.
						whenShooterSet(ev.pid, sx, sy, () => {
							ball.carrier = null;
							ballArcs.length = 0;
							ballArcs.push({
								x0: sx,
								y0: sy,
								x1: attackRimX(ev.t),
								y1: RIM_Y,
								peak,
								t0: now,
								dur: arcDur,
							});
						});
						if (ev.type === "fgaTp" || ev.type === "fgaTpFake")
							teamStats[ev.t].tpa++;
						teamStats[ev.t].fga++;
						setPlayText(`${playerName(ev.pid)} · ${labelShot(ev.type)}`);
						break;
					}
					case "fgAtRim":
					case "fgAtRimAndOne":
					case "fgLowPost":
					case "fgLowPostAndOne":
					case "fgMidRange":
					case "fgMidRangeAndOne":
					case "fgTipIn":
					case "fgTipInAndOne":
					case "fgPutBack":
					case "fgPutBackAndOne":
					case "tp":
					case "tpAndOne": {
						const tp = ev.type.startsWith("tp");
						const pts = tp ? 3 : 2;
						bumpScore(ev.t, pts);
						teamStats[ev.t].fgm++;
						if (tp) teamStats[ev.t].tpm++;
						if (ev.pidAst !== undefined) teamStats[ev.t].ast++;
						const andOne = ev.type.endsWith("AndOne") ? " (AndOne!)" : "";
						setPlayText(
							`GOOD! ${playerName(ev.pid)} · ${pts}pt${andOne}${ev.pidAst !== undefined ? " · ast " + playerName(ev.pidAst) : ""}`,
						);
						// AndOne FGs are followed by an FT — don't inbound yet.
						if (!ev.type.endsWith("AndOne") && shouldInboundAfter(ev)) {
							// ev.t scored; the OTHER team inbounds from under ev.t's rim.
							scheduleInbound({
								inboundT: ev.t === 0 ? 1 : 0,
								fromX: attackRimX(ev.t),
								fromY: 25,
								reason: "make",
							});
						}
						break;
					}
					case "missAtRim":
					case "missLowPost":
					case "missMidRange":
					case "missTp":
					case "missTipIn":
					case "missPutBack": {
						setPlayText(`MISS · ${playerName(ev.pid)} · ${labelShot(ev.type)}`);
						break;
					}
					case "blkAtRim":
					case "blkLowPost":
					case "blkMidRange":
					case "blkTp":
					case "blkTipIn":
					case "blkPutBack": {
						teamStats[ev.t].blk++;
						// Blocker (defense) meets the shot at the rim they defend.
						const blkRimX = defendRimX(ev.t);
						moveTo(
							ev.pid,
							blkRimX + (blkRimX > 47 ? -2 : 2),
							RIM_Y,
							0.3,
							"sprint",
						);
						setPlayText(`BLOCKED by ${playerName(ev.pid)}`);
						break;
					}
					case "drb":
					case "orb": {
						teamStats[ev.t].reb++;
						// Board comes off the rebounder's own attack rim (offensive board)
						// or the rim they defend (defensive board).
						const rebRimX =
							ev.type === "orb" ? attackRimX(ev.t) : defendRimX(ev.t);
						moveTo(
							ev.pid,
							rebRimX + (rebRimX > 47 ? -3 : 3),
							RIM_Y + rand(-3, 3),
							0.4,
							"sprint",
						);
						ball.carrier = ev.pid;
						// Reform happens via setupNextInterval — possession has now flipped.
						setPlayText(
							`${ev.type === "orb" ? "Off." : "Def."} rebound · ${playerName(ev.pid)}`,
						);
						break;
					}
					case "tov": {
						teamStats[ev.t].tov++;
						setPlayText(`Turnover · ${playerName(ev.pid)}`);
						// OOB inbound for the OTHER team from where ev.pid was standing.
						const losingPl = players[ev.pid];
						scheduleInbound({
							inboundT: ev.t === 0 ? 1 : 0,
							fromX: losingPl?.x ?? 47,
							fromY: losingPl?.y ?? 25,
							reason: "tov",
						});
						break;
					}
					case "stl": {
						teamStats[ev.t].stl++;
						ball.carrier = ev.pid;
						const tovPl = players[ev.pidTov];
						if (tovPl) moveTo(ev.pid, tovPl.x, tovPl.y, 0.3, "sprint");
						// Reform happens via setupNextInterval — possession has now flipped.
						setPlayText(`STEAL · ${playerName(ev.pid)}`);
						break;
					}
					case "pfFG":
					case "pfTP":
					case "pfBonus":
					case "pfNonShooting": {
						setPlayText(`Foul · ${playerName(ev.pid)}`);
						break;
					}
					case "foulOut": {
						setPlayText(`${playerName(ev.pid)} fouls out`);
						if (players[ev.pid]) players[ev.pid].gfx.alpha = 0.35;
						break;
					}
					case "ft": {
						teamStats[ev.t].fta++;
						teamStats[ev.t].ftm++;
						bumpScore(ev.t, 1);
						const rim = attackRimX(ev.t);
						const dir = attackDir(ev.t);
						// Debug: snapshot the FT alignment shortly after so window.__FT shows
						// where everyone stood relative to the lane/line/shooter.
						setTimeout(() => {
							window.__FT = {
								period: currentPeriod,
								shooter: ev.pid,
								rimX: rim,
								ftLineX: rim + dir * 14,
								players: Object.entries(players)
									.filter(([, p]) => p.onCourt)
									.map(([pid, p]) => ({
										pid: +pid,
										t: p.t,
										x: +p.x.toFixed(1),
										y: +p.y.toFixed(1),
									})),
							};
						}, 500);
						moveTo(ev.pid, rim + dir * 14, 25, 0.4, "walk");
						ball.carrier = ev.pid;
						setTimeout(() => ballArcTo(rim, RIM_Y, 0.8, 8), 400);
						setPlayText(`FT GOOD · ${playerName(ev.pid)}`);
						if (shouldInboundAfter(ev)) {
							scheduleInbound({
								inboundT: ev.t === 0 ? 1 : 0,
								fromX: attackRimX(ev.t),
								fromY: 25,
								reason: "make",
							});
						}
						break;
					}
					case "missFt": {
						teamStats[ev.t].fta++;
						const rim = attackRimX(ev.t);
						const dir = attackDir(ev.t);
						moveTo(ev.pid, rim + dir * 14, 25, 0.4, "walk");
						ball.carrier = ev.pid;
						setTimeout(() => ballArcTo(rim, RIM_Y, 0.8, 8), 400);
						setPlayText(`FT MISS · ${playerName(ev.pid)}`);
						break;
					}
					case "sub": {
						// Replace players in onCourt; rebuild visuals if needed.
						const t = ev.t;
						for (let i = 0; i < ev.pidsOff.length; i++) {
							const off = ev.pidsOff[i],
								on = ev.pids[i];
							const idx = onCourt[t].indexOf(off);
							if (idx === -1) continue;
							// Off player: fade out + park off-court.
							const offPl = players[off];
							if (offPl) {
								offPl.gfx.alpha = 0.0;
								offPl.onCourt = false;
							}
							// On player: instantiate if first time on court.
							const teamInfo = teams[t];
							let info = teamInfo?.players.find((p) => p.pid === on);
							if (!info) info = { pid: on, name: `#${on}`, pos: "F" };
							if (!players[on]) players[on] = makePlayer(info, t, idx);
							else {
								players[on].gfx.alpha = 1.0;
								players[on].onCourt = true;
								players[on].slot = idx;
							}
							onCourt[t][idx] = on;
							const role = POS_TO_ROLE[info.pos ?? ""] ?? "SF";
							const [x, y] = offensiveRoleSpot(t, role, currentSet[role] ?? 0);
							players[on].x = x;
							players[on].y = y;
							players[on].gfx.position.set(x, y);
						}
						assignRolesForTeam(t); // re-hand-out distinct slots after the swap
						setPlayText(`${teamLabel(t)} sub`);
						break;
					}
					case "timeout": {
						setPlayText(`${teamLabel(ev.t)} timeout (${ev.numLeft} left)`);
						break;
					}
					case "endOfPeriod": {
						setPlayText(`End of ${quarterEl.textContent}`);
						break;
					}
					case "outOfBounds": {
						// BBGM convention (GameSim.basketball doOutOfBounds): ev.t is the team
						// that knocked the ball out — the team's last touch sent it OOB — and
						// ev.on labels whether the offense or defense did it. In BOTH cases the
						// OTHER team gains possession and inbounds, so inboundT is always 1-ev.t.
						const inboundT = ev.t === 0 ? 1 : 0;
						setPlayText(`Out of bounds · ${teamLabel(inboundT)} ball`);
						scheduleInbound({
							inboundT,
							fromX: ball.x,
							fromY: ball.y,
							reason: "oob",
						});
						break;
					}
					case "injury": {
						setPlayText(`Injury · ${playerName(ev.pid)}`);
						break;
					}
					case "gameOver": {
						gameOver = true;
						const w = scores[0] > scores[1] ? 0 : 1;
						setPlayText(
							`FINAL · ${teamLabel(w)} wins ${scores[w]}–${scores[1 - w]}`,
						);
						quarterEl.textContent = "FINAL";
						break;
					}
					default:
						// Silently ignore unknown event types.
						break;
				}
				renderStats();
			}

			function labelShot(type) {
				return (
					{
						fgaAtRim: "drive at rim",
						fgaLowPost: "low post",
						fgaMidRange: "mid-range jumper",
						fgaTp: "three",
						fgaTpFake: "pump-fake three",
						fgaTipIn: "tip in",
						fgaPutBack: "put-back",
						missAtRim: "at-rim attempt",
						missLowPost: "low post",
						missMidRange: "mid-range",
						missTp: "three",
						missTipIn: "tip in",
						missPutBack: "put-back",
					}[type] ?? type
				);
			}

			// ── Event pacing with full-game lookahead ─────────────────────────────────
			// The entire pre-simulated game arrives in one gameStart packet, so we ALWAYS
			// know the next event before processing the current one. That's what makes
			// motion realistic: the shooter for event N+1 starts moving toward the elbow
			// the moment event N (a defensive rebound, say) resolves — and arrives just as
			// event N+1 fires.
			const eventQueue = [];
			let nextEarliestMs = 0;
			let drainTimer = null;

			// ── Timeline playhead + event pump (replaces the setTimeout gap drain) ──────
			// Advance the smooth game-clock playhead each frame and fire every event it has
			// reached. Events feed the keyframe tracks (via setupNextInterval → moveTo), and
			// players/ball are sampled from those tracks — so pacing is one steady playhead,
			// not a chain of variable setTimeouts, killing the old speed-pulse jitter.
			function advanceTimeline(dt) {
				if (playhead === null) {
					const first = eventQueue.find((e) => typeof e.clock === "number");
					if (!first) return;
					playhead = first.clock;
					playheadPeriod = currentPeriod;
				}
				const eff = Math.max(0.2, gameRate * speed);
				playhead -= dt * eff;
				// Track BBGM's live (tick-extrapolated) clock when running near real-time so we
				// never drift out of sync; below ~0.9× we intentionally let the playhead lag —
				// that lag IS the slow-motion the user asked for.
				if (
					speed >= 0.9 &&
					bbgmClock !== null &&
					currentPeriod === bbgmPeriod &&
					lastTick
				) {
					const sinceTick = (performance.now() - lastTick.recvMs) / 1000;
					const estBbgm = bbgmClock - gameRate * sinceTick;
					playhead += (estBbgm - playhead) * Math.min(1, dt * 2);
				}
				pumpEvents();
			}
			function pumpEvents() {
				let guard = 0;
				while (eventQueue.length && guard++ < 300) {
					const head = eventQueue[0];
					const hasClock = typeof head.clock === "number";
					// A big upward clock jump = new quarter/OT: snap the playhead to it and
					// re-anchor every track to its current spot so nobody splines across the
					// period break.
					if (hasClock && playhead !== null && head.clock > playhead + 20) {
						playhead = head.clock;
						playheadPeriod = head.period ?? playheadPeriod;
						for (const pid in players) {
							if (players[pid].onCourt) resetTrack(players[pid], players[pid].x, players[pid].y);
						}
					}
					// Fire clockless events (subs, timeouts) immediately; timed events when the
					// playhead has descended to their clock.
					if (hasClock && playhead > head.clock) break;
					const ev = eventQueue.shift();
					const next = eventQueue[0];
					const next2 = eventQueue[1];
					handleEvent(ev);
					updatePossession(ev, next);
					let deltaGame = 0;
					if (
						next &&
						typeof ev.clock === "number" &&
						typeof next.clock === "number" &&
						next.clock <= ev.clock
					) {
						deltaGame = ev.clock - next.clock;
					}
					const eff = Math.max(0.2, gameRate * speed);
					const gapRealSec = Math.max(0.1, deltaGame / eff);
					pacingCtx = {
						prev: ev,
						gapStartedAt: performance.now(),
						gap: gapRealSec,
						gapGame: deltaGame,
					};
					setupNextInterval(next, next2, gapRealSec, deltaGame);
				}
			}
			// The playhead pump is the sole drainer now; keep this a no-op so the existing
			// callers (gameStart / resume / applyControl) are harmless.
			function scheduleDrain() {}
			function scheduleDrain_OLD() {
				if (drainTimer !== null) return;
				if (paused) return; // resumeSim() re-arms the drain
				if (eventQueue.length === 0) return;
				const wait = Math.max(0, nextEarliestMs - performance.now());
				drainTimer = setTimeout(() => {
					drainTimer = null;
					if (eventQueue.length === 0) return;
					const ev = eventQueue.shift();
					// Real-time gap until the NEXT event in the queue, derived from game-clock.
					const next = eventQueue[0];
					const next2 = eventQueue[1];
					handleEvent(ev);
					updatePossession(ev, next);
					let deltaSec = 0;
					if (
						next &&
						typeof ev.clock === "number" &&
						typeof next.clock === "number" &&
						next.clock <= ev.clock
					) {
						deltaSec = ev.clock - next.clock;
					}
					// Real screen-time for this event = the TRUE game-clock delta divided by
					// the live gameRate (slaved to BBGM's playback cadence) and the manual
					// fine-tune multiplier. NO flattening clamp — a 2s possession and a 20s
					// possession get proportionally different time on screen, so cranking
					// BBGM's speed makes players streak and pausing freezes them. The wide
					// [GAP_FLOOR, GAP_CEIL] guard only stops clustered events (same clock →
					// delta 0) from firing instantly and stops a stalled tick from freezing
					// the floor for many seconds — it does not compress normal pacing.
					const effRate = gameRate * speed;
					let gapRealSec = Math.max(
						GAP_FLOOR,
						Math.min(deltaSec / effRate, GAP_CEIL),
					);
					// Drift correction: if BBGM's text has already run ahead (user hit
					// fast-forward / play-until-next-score), blast through events below the
					// floor — the further behind, the shorter the gap — so simcast snaps
					// back into lockstep instead of trailing by whole possessions.
					const lag = bbgmLagSeconds(ev);
					// Only blur-catch-up when running at (near) BBGM's pace. When the user
					// has deliberately dialed the speed below ~0.9× to study the motion, DON'T
					// race to stay in lockstep — that's what kept "slowest" feeling too fast.
					if (lag > CATCHUP_THRESH && speed >= 0.9) {
						gapRealSec = Math.max(0.06, GAP_FLOOR - (lag - CATCHUP_THRESH) * 0.02);
					} else if (
						bbgmClock !== null &&
						lastTick &&
						next &&
						typeof next.clock === "number" &&
						currentPeriod === bbgmPeriod
					) {
						// Ahead-brake. Extrapolate where BBGM's clock is right now (its last
						// tick + gameRate elapsed since), and if draining `next` would jump the
						// court past that point by more than AHEAD_THRESH, stretch the gap to
						// wait for the play-by-play to get there. Keeps slow speeds slow/smooth.
						const sinceTick = (performance.now() - lastTick.recvMs) / 1000;
						const estBbgm = bbgmClock - gameRate * sinceTick; // remaining, counting down
						const aheadSec = estBbgm - next.clock; // >0 → next is past BBGM
						if (aheadSec > AHEAD_THRESH) {
							const waitSec = aheadSec / Math.max(gameRate, 0.75);
							gapRealSec = Math.max(gapRealSec, Math.min(waitSec, MAX_WAIT));
						}
					}

					// 2-event lookahead: pass N+1 AND N+2 so planMotion can stage assists
					// (assister parks at passing distance before the make fires) and
					// pre-stage fastbreak shooters during rebounds/steals.
					pacingCtx = {
						prev: ev,
						gapStartedAt: performance.now(),
						gap: gapRealSec,
						gapGame: deltaSec,
					};
					setupNextInterval(next, next2, gapRealSec, deltaSec);

					// Math.max so tipoff/inbound handlers that pre-extend the gap (via their
					// own nextEarliestMs += duration) aren't truncated by this baseline gap.
					nextEarliestMs = Math.max(
						nextEarliestMs,
						performance.now() + gapRealSec * 1000,
					);
					scheduleDrain();
				}, wait);
			}

			// ── Playback-sync helpers ─────────────────────────────────────────────────
			// Re-estimate gameRate from the interval between two consecutive BBGM ticks,
			// measured against our OWN arrival clock (avoids cross-machine clock skew).
			// A period rollover makes the game-clock jump UP (dGame < 0) and is skipped.
			let lastInst = null; // debug: most recent instantaneous rate sample
			function updateRate(gameClock) {
				const recvMs = performance.now();
				if (lastTick) {
					const dGame = lastTick.gameClock - gameClock; // >0 as clock counts down
					const dWall = (recvMs - lastTick.recvMs) / 1000;
					if (dGame > 0 && dWall > 0.02) {
						const inst = dGame / dWall;
						lastInst = +inst.toFixed(2);
						if (inst >= RATE_MIN && inst <= RATE_MAX) {
							gameRate = gameRate * 0.7 + inst * 0.3; // EMA (smoothed)
						}
					}
				}
				lastTick = { gameClock, recvMs };
			}

			function pauseSim() {
				if (paused) return;
				paused = true;
				if (drainTimer !== null) {
					clearTimeout(drainTimer);
					drainTimer = null;
					pausePerfRemainingMs = Math.max(0, nextEarliestMs - performance.now());
				}
				setConn("idle", "paused");
			}

			function resumeSim() {
				if (!paused) return;
				paused = false;
				lastTick = null; // restart the rate window cleanly after the gap
				nextEarliestMs = performance.now() + pausePerfRemainingMs;
				setConn("live", "live");
				scheduleDrain();
			}

			function applyControl(m) {
				if (m.paused === true) pauseSim();
				else if (m.paused === false) resumeSim();
				if (typeof m.gameClock === "number") {
					bbgmClock = m.gameClock;
					if (typeof m.period === "number") bbgmPeriod = m.period;
					if (!paused) {
						updateRate(m.gameClock);
						// If BBGM just jumped well ahead (fast-forward), don't sit out a long
						// gap that was scheduled while we were pacing slowly — re-arm the drain
						// now so catch-up engages immediately instead of after MAX_WAIT.
						if (
							drainTimer !== null &&
							eventQueue[0] &&
							bbgmLagSeconds(eventQueue[0]) > CATCHUP_THRESH
						) {
							clearTimeout(drainTimer);
							drainTimer = null;
							nextEarliestMs = performance.now();
							scheduleDrain();
						}
					}
				}
			}

			// How far (in game-seconds) simcast trails BBGM's live playback for the event
			// we're about to time. Positive → simcast is behind and should hurry. A whole
			// unrendered period counts as a large lag so we blur through it.
			function bbgmLagSeconds(ev) {
				if (bbgmClock === null || typeof ev?.clock !== "number") return 0;
				if (currentPeriod < bbgmPeriod) return 999;
				if (currentPeriod > bbgmPeriod) return 0;
				return ev.clock - bbgmClock; // clock = seconds remaining; higher = earlier
			}

			// ── WebSocket ─────────────────────────────────────────────────────────────
			let ws;
			function connect() {
				const proto = location.protocol === "https:" ? "wss" : "ws";
				ws = new WebSocket(`${proto}://${location.host}/api/simcast`);
				ws.onopen = () => setConn("idle", "connected");
				ws.onclose = () => {
					setConn("dead", "disconnected");
					setTimeout(connect, 1500);
				};
				ws.onerror = () => setConn("dead", "error");
				ws.onmessage = (msg) => {
					let m;
					try {
						m = JSON.parse(msg.data);
					} catch {
						return;
					}
					if (m.kind === "gameStart") {
						setConn("live", "live");
						initFromGameStart(m);
					} else if (m.kind === "control") {
						applyControl(m);
					}
					// No more "event" messages — the entire game arrives in gameStart.events.
				};
			}
			connect();

			// ── Debug hook (browser_evaluate inspection) ──────────────────────────────
			window.__SIM = () => ({
				possessionTeam,
				currentPlay,
				gameOver,
				paused,
				gameRate: +gameRate.toFixed(2),
				paceScale: +paceScale().toFixed(2),
				playhead: playhead !== null ? +playhead.toFixed(1) : null,
				queueLen0: eventQueue.length,
				lastInst,
				bbgmClock,
				speed,
				queueLen: eventQueue.length,
				moving: Object.values(players).filter(
					(p) => p.onCourt && Math.hypot(p.vx, p.vy) > 0.7,
				).length,
				drainTimer: drainTimer !== null,
				waitMs: Math.round(nextEarliestMs - performance.now()),
				nextEv: eventQueue[0]?.type ?? null,
				ball: {
					x: +ball.x.toFixed(1),
					y: +ball.y.toFixed(1),
					z: +ball.z.toFixed(1),
					carrier: ball.carrier,
				},
				play: playEl.textContent,
				clock: clockEl.textContent,
				players: Object.entries(players)
					.filter(([, p]) => p.onCourt)
					.map(([pid, p]) => ({
						pid: +pid,
						t: p.t,
						pos: p.info.pos,
						x: +p.x.toFixed(1),
						y: +p.y.toFixed(1),
						tx: +p.tx.toFixed(1),
						ty: +p.ty.toFixed(1),
						v: +Math.hypot(p.vx, p.vy).toFixed(1),
					})),
			});
			// Court-calibration debug: fade the textured court to reveal the procedural
			// rim/key drawn at exact logical coords, so the two can be visually compared.
			window.__courtAlpha = (a) => {
				if (courtSprite) courtSprite.alpha = a;
			};

			// ── Ticker (animation only) ───────────────────────────────────────────────
			app.ticker.add((ticker) => {
				// Paused (BBGM paused) → freeze the sim-clock so every tween, ball arc, and
				// idle drift holds exactly in place until BBGM resumes.
				if (paused) return;
				const dt = ticker.deltaMS / 1000;
				now += dt;

				// Advance the timeline playhead and fire any events it has reached.
				advanceTimeline(dt);

				// Sample every on-court player from their keyframe track at the playhead. The
				// Catmull-Rom spline carries them THROUGH waypoints without the old stop-at-
				// every-target stutter. When a player has no waypoint ahead (sitting on their
				// last keyframe) a whisper of drift keeps them from looking frozen.
				for (const pid in players) {
					const pl = players[pid];
					if (!pl.onCourt) continue;
					if (playhead !== null && pl.kf && pl.kf.length) {
						pruneTrack(pl.kf);
						const s = sampleTrack(pl.kf, playhead);
						if (s) {
							// Instantaneous velocity (ft/s) for the ball's dribble hand + tempo.
							pl.vx = (s.x - pl.x) / Math.max(dt, 1e-3);
							pl.vy = (s.y - pl.y) / Math.max(dt, 1e-3);
							pl.x = s.x;
							pl.y = s.y;
						}
						if (playhead <= pl.kf[pl.kf.length - 1].c + 0.02) {
							driftSeeds[pid] += dt * 0.5;
							pl.x += Math.cos(driftSeeds[pid]) * 0.08 * dt;
							pl.y += Math.sin(driftSeeds[pid] * 1.3) * 0.07 * dt;
						}
					}
					pl.gfx.position.set(pl.x, pl.y);
				}

				// Pairwise collision avoidance — push overlapping players apart so they
				// never visually stack regardless of tween targets.
				const COLLISION_R = 1.5; // soft-collision radius (≈ one dot wide)
				const onCourtPids = [];
				for (const pid in players) {
					if (players[pid].onCourt) onCourtPids.push(pid);
				}
				for (let i = 0; i < onCourtPids.length; i++) {
					for (let j = i + 1; j < onCourtPids.length; j++) {
						const a = players[onCourtPids[i]];
						const b = players[onCourtPids[j]];
						const dx = b.x - a.x,
							dy = b.y - a.y;
						const d = Math.hypot(dx, dy);
						const minD = COLLISION_R * 2;
						if (d < minD && d > 0.01) {
							const push = (minD - d) / 2 + 0.02;
							const ux = dx / d,
								uy = dy / d;
							a.x -= ux * push;
							a.y -= uy * push;
							b.x += ux * push;
							b.y += uy * push;
							a.gfx.position.set(a.x, a.y);
							b.gfx.position.set(b.x, b.y);
						}
					}
				}

				// Boundary clamp — no player escapes the apron.
				const MIN_X = -APRON_FT,
					MAX_X = COURT.length + APRON_FT;
				const MIN_Y = -APRON_FT,
					MAX_Y = COURT.width + APRON_FT;
				for (const pid of onCourtPids) {
					const pl = players[pid];
					let cx = pl.x,
						cy = pl.y;
					if (cx < MIN_X) cx = MIN_X;
					else if (cx > MAX_X) cx = MAX_X;
					if (cy < MIN_Y) cy = MIN_Y;
					else if (cy > MAX_Y) cy = MAX_Y;
					if (cx !== pl.x || cy !== pl.y) {
						pl.x = cx;
						pl.y = cy;
						pl.gfx.position.set(cx, cy);
					}
				}

				// Name-label collision pass — when another player sits directly below a
				// dot, flip this dot's name label above so the two labels don't stack.
				// Cheap heuristic: scan neighbors within a thin horizontal band.
				const LABEL_DX = 2.6; // horizontal proximity that would cause label overlap
				const LABEL_DY = 2.6; // vertical proximity below dot where a neighbor's
				// dot/label would collide with our default-below label
				for (let i = 0; i < onCourtPids.length; i++) {
					const a = players[onCourtPids[i]];
					if (!a.nameLabel) continue;
					let flipUp = false;
					for (let j = 0; j < onCourtPids.length; j++) {
						if (i === j) continue;
						const b = players[onCourtPids[j]];
						const dx = Math.abs(b.x - a.x);
						const dy = b.y - a.y; // positive when b is below a (court y grows down)
						if (dx < LABEL_DX && dy > 0 && dy < LABEL_DY) {
							flipUp = true;
							break;
						}
					}
					if (flipUp !== a.nameAbove) {
						if (flipUp) {
							a.nameLabel.anchor.set(0.5, 1);
							a.nameLabel.position.set(0, -a.r - 0.25);
						} else {
							a.nameLabel.anchor.set(0.5, 0);
							a.nameLabel.position.set(0, a.r + 0.25);
						}
						a.nameAbove = flipUp;
					}
				}

				// Ball.
				// Teleport guard: whenever the carrier is (re)assigned to someone far from
				// where the ball physically is — a possession change, an inbounder who snaps
				// to the apron, a rebound outlet — DON'T let the follow code below yank the
				// ball onto them in one frame. Fly it there with a quick pass arc and attach
				// when it lands. Intentional passes already arc (they go carrier=null first,
				// landing on the receiver → gap≈0 → no double-bridge), so this only catches
				// the direct reassignments that used to teleport.
				if (
					ball.carrier &&
					players[ball.carrier] &&
					ball.carrier !== lastCarrier &&
					ball._bridging !== ball.carrier
				) {
					const nc = players[ball.carrier];
					const gap = Math.hypot(nc.x - ball.x, nc.y - ball.y);
					if (gap > 5) {
						ballArcs.length = 0;
						ball._bridging = ball.carrier;
						ballArcs.push({
							x0: ball.x,
							y0: ball.y,
							x1: nc.x,
							y1: nc.y,
							peak: Math.min(6, gap * 0.12),
							t0: now,
							dur: clamp(gap / 60, 0.18, 0.6),
						});
					}
				}

				if (ball._bridging) {
					// Ball is in flight toward its freshly-assigned carrier. Retarget the arc
					// endpoint to the carrier's LIVE position each frame (they keep moving),
					// and attach on landing.
					const tgt = players[ball._bridging];
					const a = ballArcs[0];
					if (!tgt || !a) {
						ball._bridging = null;
						lastCarrier = null;
						lastCarrierXY = null;
					} else {
						a.x1 = tgt.x;
						a.y1 = tgt.y;
						const u = Math.min(1, (now - a.t0) / a.dur);
						ball.x = a.x0 + (a.x1 - a.x0) * u;
						ball.y = a.y0 + (a.y1 - a.y0) * u;
						ball.z = 4 * a.peak * u * (1 - u);
						if (u >= 1) {
							ballArcs.shift();
							ball._bridging = null;
							lastCarrier = null;
							lastCarrierXY = null;
						}
					}
				} else if (ball.carrier && players[ball.carrier]) {
					const c = players[ball.carrier];
					// Carrier velocity (ft/s) from last frame → dribble tempo + hand side.
					let vx = 0,
						vy = 0;
					if (lastCarrier === ball.carrier && lastCarrierXY) {
						vx = c.x - lastCarrierXY.x;
						vy = c.y - lastCarrierXY.y;
					}
					const spd = Math.hypot(vx, vy) / Math.max(dt, 1e-3);
					// Idle handle ~4 bounces/s, up to ~9/s at a full sprint (a driving blur).
					const tempo = 4 + Math.min(spd, 20) * 0.28;
					dribblePhase += dt * tempo;
					// |sin| so the ball always rises back off the floor; ~2.4 ft peak.
					ball.z = 2.4 * Math.abs(Math.sin(dribblePhase));
					// Rest the ball on the carrier's right/hip; when moving, lead it out in
					// front and to the side (the hand that's protecting/pushing the ball).
					let ox = c.r * 0.85,
						oy = -c.r * 0.15;
					const vlen = Math.hypot(vx, vy);
					if (vlen > 0.02) {
						const nx = vx / vlen,
							ny = vy / vlen;
						ox = nx * c.r * 1.1 - ny * c.r * 0.5;
						oy = ny * c.r * 1.1 + nx * c.r * 0.5;
					}
					ball.x = c.x + ox;
					ball.y = c.y + oy;
					lastCarrier = ball.carrier;
					lastCarrierXY = { x: c.x, y: c.y };
				} else if (ballArcs.length) {
					lastCarrier = null;
					lastCarrierXY = null;
					const a = ballArcs[0];
					const u = Math.min(1, (now - a.t0) / a.dur);
					ball.x = a.x0 + (a.x1 - a.x0) * u;
					ball.y = a.y0 + (a.y1 - a.y0) * u;
					ball.z = 4 * a.peak * u * (1 - u);
					if (u >= 1) ballArcs.shift();
				} else {
					lastCarrier = null;
					lastCarrierXY = null;
				}
				ballShadow.position.set(ball.x, ball.y);
				ballGfx.position.set(ball.x, ball.y - ball.z * 0.5);
				const shrink = 1 - Math.min(0.5, ball.z * 0.05);
				ballShadow.scale.set(shrink, shrink);
			});
		</script>
	</body>
</html>
