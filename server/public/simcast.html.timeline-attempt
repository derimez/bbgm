			// Player factory
			function makePlayer(pInfo, t, slot) {
				const color = teamColors[t].primary;
				const ringC = teamColors[t].secondary;
				// Use white text unless the dot color is too light, in which case use the
				// secondary color for contrast.
				const posTextC = 0xffffff;
				const r = dotRadius(POS_HGT[pInfo.pos] ?? 78);

				const cont = new PIXI.Container();
				const dot = new PIXI.Graphics();
				dot.circle(0, 0, r).fill(color).stroke({ color: ringC, width: 0.32 });
