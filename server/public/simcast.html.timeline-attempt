				// Pick one at random per game so dupes within an era cycle visually.
				const pool = Array.isArray(picked.images)
					? picked.images
					: picked.image
						? [picked.image]
						: [];
				if (pool.length === 0) return null;
				const image = pool[Math.floor(Math.random() * pool.length)];
				return { ...picked, image };
